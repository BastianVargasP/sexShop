<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%-include('partials/head')%>
</head>
<body class="bg-surface text-on-surface min-h-screen flex relative flex-col">
<!-- TopNavBar -->
<%-include('partials/header')%>
<!-- Main Content -->
<main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 pb-32">
    <div class="mb-12">
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-4">Nuestra Colección</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Descubre una selección curada de piezas diseñadas para elevar tus sentidos y redefinir el bienestar íntimo con elegancia y sofisticación.</p>
    </div>
    <div class="flex flex-col lg:flex-row gap-gutter">
        <!-- Sidebar Filters -->
        <aside class="w-full lg:w-1/4 flex-shrink-0 space-y-8 glass-panel p-6 rounded-lg self-start top-28">
            <div class="mb-6 flex justify-between items-center">
                <h2 class="font-headline-md text-xl text-secondary">Filtros</h2>
                <button type="button" id="limpiarFiltro" class="text-on-surface-variant hover:text-secondary text-sm flex items-center gap-1 transition-colors">
                    <span class="material-symbols-outlined text-sm">restart_alt</span> Limpiar
                </button>
            </div>
            <!-- Category Filter -->
            <div class="space-y-4">
                <h3 class="font-label-md text-label-md text-on-surface border-b border-surface-variant pb-2">Categoría</h3>
                <ul class="space-y-2">
                    <li>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input name="categoria" value="joyeria" class="form-checkbox h-4 w-4 text-primary-container bg-surface-container-highest border-outline-variant focus:ring-primary focus:ring-offset-background rounded-sm" type="checkbox">
                            <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary transition-colors">Joyería Íntima</span>
                        </label>
                    </li>
                    <li>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input name="categoria" value="estimuladores" class="form-checkbox h-4 w-4 text-primary-container bg-surface-container-highest border-outline-variant focus:ring-primary focus:ring-offset-background rounded-sm" type="checkbox">
                            <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary transition-colors">Estimuladores Premium</span>
                        </label>
                    </li>
                    <li>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input name="categoria" value="cosmetica" class="form-checkbox h-4 w-4 text-primary-container bg-surface-container-highest border-outline-variant focus:ring-primary focus:ring-offset-background rounded-sm" type="checkbox">
                            <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary transition-colors">Cosmética Sensorial</span>
                        </label>
                    </li>
                    <li>
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input name="categoria" value="kits" class="form-checkbox h-4 w-4 text-primary-container bg-surface-container-highest border-outline-variant focus:ring-primary focus:ring-offset-background rounded-sm" type="checkbox">
                            <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary transition-colors">Kits Exclusivos</span>
                        </label>
                    </li>
                </ul>
            </div>
        </aside>
        <!-- Product Grid -->
        <div class="flex-1">
            <div class="flex justify-between items-center mb-6">
                <span id="contadorProductos" class="font-label-sm text-label-sm text-on-surface-variant">
                    <%= productos.length %> producto<%= productos.length !== 1 ? 's' : '' %> encontrado<%= productos.length !== 1 ? 's' : '' %>
                </span>
                <div class="flex items-center gap-2">
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Ordenar por:</span>
                    <select id="ordenSelect" class="bg-surface-container border border-outline-variant text-on-surface text-sm rounded focus:ring-secondary focus:border-secondary p-1 pr-8">
                        <option value="recomendados">Recomendados</option>
                        <option value="precio-asc">Precio: Menor a Mayor</option>
                        <option value="precio-desc">Precio: Mayor a Menor</option>
                        <option value="novedades">Novedades</option>
                    </select>
                </div>
            </div>

            <div id="estadoVacio" class="glass-panel rounded-xl p-16 flex flex-col items-center justify-center text-center gap-4" style="display:none;">
                <span class="material-symbols-outlined text-secondary text-5xl">search_off</span>
                <p class="font-body-md text-body-md text-on-surface-variant">No encontramos productos con esos filtros.</p>
                <button type="button" id="limpiarFiltroVacio" onclick="document.querySelector('#limpiarFiltro').click()" class="mt-2 font-label-md text-label-md text-secondary hover:text-secondary-fixed underline underline-offset-4 transition-colors">
                    Ver toda la colección
                </button>
            </div>

            <div id="gridProductos" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                <% productos.forEach(producto => { %>
                <% const esFavorito = favoritosIds.has(producto.id); %>
                <!-- Product Card -->
                <div class="producto-card relative glass-panel rounded-lg overflow-hidden flex flex-col hover-gold-glow transition-all duration-300 group bg-surface-container-low border border-surface-container"
                     data-categoria="<%= producto.categoria %>"
                     data-precio="<%= producto.precio %>"
                     data-creado="<%= new Date(producto.created_at).getTime() %>"
                     data-destacado="<%= producto.destacado ? '1' : '0' %>">
                    <% if (producto.etiqueta) { %>
                    <div class="absolute top-4 left-4 z-10 bg-primary-fixed-dim text-on-primary-fixed text-xs font-bold px-2 py-1 rounded-sm uppercase tracking-wider">
                        <%= producto.etiqueta %>
                    </div>
                    <% } %>
                    <button type="button" data-favorito-toggle data-producto-id="<%= producto.id %>" data-favorito="<%= esFavorito ? 'true' : 'false' %>"
                            title="<%= esFavorito ? 'Quitar de favoritos' : 'Añadir a favoritos' %>"
                            class="absolute top-4 right-4 z-10 <%= esFavorito ? 'text-secondary' : 'text-on-surface-variant hover:text-secondary' %> transition-colors">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' <%= esFavorito ? 1 : 0 %>;">favorite</span>
                    </button>
                    <div class="relative h-80 w-full overflow-hidden bg-surface-container-lowest">
                        <a href="/producto/<%= producto.id %>" class="block w-full h-full">
                            <img class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                        </a>
                    </div>
                    <div class="p-5 flex flex-col gap-2 relative z-20 bg-gradient-to-t from-surface-container-highest via-surface-container/90 to-transparent">
                        <a href="/producto/<%= producto.id %>">
                            <h3 class="font-headline-md text-lg text-on-surface group-hover:text-secondary transition-colors truncate"><%= producto.nombre %></h3>
                        </a>
                        <p class="font-body-md text-sm text-on-surface-variant line-clamp-2"><%= producto.descripcion_corta %></p>
                        <div class="flex justify-between items-center mt-2">
                            <span class="font-label-md text-lg text-secondary"><%= Number(producto.precio).toFixed(2) %>€</span>
                            <button class="bg-secondary text-on-secondary-container hover:bg-secondary-fixed transition-colors p-2 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm">shopping_bag</span>
                            </button>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</main>
<!-- Footer -->
<%-include('partials/footer')%>
<script src="/javascripts/productos.js"></script>
<script src="/javascripts/favoritos.js"></script>
</body></html>
