<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%-include('partials/head')%>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-lg">
<!-- TopNavBar -->
<%-include('partials/header')%>
<!-- Main Layout -->
<main class="flex-grow flex flex-col md:flex-row px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full gap-gutter py-12">
    <!-- Sidebar Navigation -->
    <%- include('partials/sidebar-cuenta', { activo: 'favoritos' }) %>
    <!-- Main Content Area -->
    <section class="flex-grow flex flex-col gap-8">
        <header class="flex justify-between items-end border-b border-surface-container pb-4">
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">Mis Favoritos</h1>
            <span id="contadorFavoritos" class="font-body-md text-body-md text-on-surface-variant"><%= favoritos.length %> Artículo<%= favoritos.length !== 1 ? 's' : '' %></span>
        </header>

        <div id="estadoVacioFavoritos" class="glass-panel rounded-xl p-12 flex flex-col items-center justify-center text-center gap-4" style="<%= favoritos.length === 0 ? '' : 'display:none;' %>">
            <span class="material-symbols-outlined text-secondary text-5xl">favorite_border</span>
            <p class="font-body-md text-body-md text-on-surface-variant">Aún no has agregado productos a tu lista de deseos.</p>
            <a href="/productos" class="mt-2 font-label-md text-label-md text-secondary hover:text-secondary-fixed underline underline-offset-4 transition-colors">
                Explorar colección
            </a>
        </div>

        <!-- Favorites Grid -->
        <div id="gridFavoritos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" style="<%= favoritos.length === 0 ? 'display:none;' : '' %>">
            <% favoritos.forEach(fav => { %>
            <!-- Product Card -->
            <div class="producto-card relative glass-panel rounded-lg overflow-hidden flex flex-col hover-gold-glow transition-all duration-300 group cursor-pointer bg-surface-container-low border border-surface-container">
                <% if (fav.etiqueta) { %>
                <div class="absolute top-4 left-4 z-10 bg-primary-container text-secondary text-xs font-bold px-2 py-1 rounded-sm uppercase tracking-wider">
                    <%= fav.etiqueta %>
                </div>
                <% } %>
                <button type="button" data-favorito-toggle data-producto-id="<%= fav.producto_id %>" data-favorito="true" data-eliminar-tarjeta-al-quitar="true"
                        title="Quitar de favoritos" class="absolute top-4 right-4 z-10 text-secondary transition-colors">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">favorite</span>
                </button>
                <div class="relative h-80 w-full overflow-hidden bg-surface-container-lowest">
                    <a href="/producto/<%= fav.producto_id %>" class="block w-full h-full">
                        <% if (fav.producto_imagen) { %>
                        <img class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100" src="<%= fav.producto_imagen %>" alt="<%= fav.producto_nombre %>">
                        <% } else { %>
                        <div class="w-full h-full flex items-center justify-center text-outline-variant">
                            <span class="material-symbols-outlined text-6xl">image</span>
                        </div>
                        <% } %>
                    </a>
                </div>
                <div class="p-5 flex flex-col gap-2 relative z-20 bg-gradient-to-t from-surface-container-highest via-surface-container/90 to-transparent">
                    <a href="/producto/<%= fav.producto_id %>">
                        <h3 class="font-headline-md text-lg text-on-surface group-hover:text-secondary transition-colors truncate"><%= fav.producto_nombre %></h3>
                    </a>
                    <% if (fav.producto_descripcion) { %>
                    <p class="font-body-md text-sm text-on-surface-variant line-clamp-2"><%= fav.producto_descripcion %></p>
                    <% } %>
                    <div class="flex justify-between items-center mt-2">
                        <span class="font-label-md text-lg text-secondary"><%= Number(fav.precio).toFixed(2) %>€</span>
                        <button class="bg-secondary text-on-secondary-container hover:bg-secondary-fixed transition-colors p-2 rounded-full flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">shopping_bag</span>
                        </button>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </section>
</main>
<!-- Footer -->
<%-include('partials/footer')%>
<script src="/javascripts/favoritos.js"></script>
</body></html>
