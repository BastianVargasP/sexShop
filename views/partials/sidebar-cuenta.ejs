<aside class="w-full md:w-1/4 flex-shrink-0">
    <div class="glass-panel rounded-xl p-6 top-28 bg-surface-container">
        <div class="flex items-center gap-4 mb-8 pb-6 border-b border-secondary/10">
            <div class="w-16 h-16 rounded-full bg-surface-container-highest flex items-center justify-center overflow-hidden border border-secondary/20">
                <span class="material-symbols-outlined text-secondary text-3xl">account_circle</span>
            </div>
            <div>
                <h2 class="font-headline-md text-body-lg font-bold text-on-surface"><%= usuario.nombre %> <%= usuario.apellido %></h2>
                <p class="font-body-md text-label-sm text-on-surface-variant">Socia Premium</p>
            </div>
        </div>
        <nav class="flex flex-col gap-2">
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-300 <%= activo === 'perfil' ? 'font-label-md text-label-md text-secondary bg-surface-container-high border-l-2 border-secondary' : 'text-on-surface-variant hover:text-secondary hover:bg-surface-container-highest' %>" href="/perfil">
                <span class="material-symbols-outlined">person</span>
                <span class="font-label-md text-label-md">Mis datos</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-300 <%= activo === 'pedidos' ? 'font-label-md text-label-md text-secondary bg-surface-container-high border-l-2 border-secondary' : 'text-on-surface-variant hover:text-secondary hover:bg-surface-container-highest' %>" href="/pedidos">
                <span class="material-symbols-outlined">receipt_long</span>
                <span class="font-label-md text-label-md">Mis pedidos</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-300 <%= activo === 'direcciones' ? 'font-label-md text-label-md text-secondary bg-surface-container-high border-l-2 border-secondary' : 'text-on-surface-variant hover:text-secondary hover:bg-surface-container-highest' %>" href="/direcciones">
                <span class="material-symbols-outlined">location_on</span>
                <span class="font-label-md text-label-md">Direcciones</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-300 <%= activo === 'favoritos' ? 'font-label-md text-label-md text-secondary bg-surface-container-high border-l-2 border-secondary' : 'text-on-surface-variant hover:text-secondary hover:bg-surface-container-highest' %>" href="/favoritos">
                <span class="material-symbols-outlined">favorite</span>
                <span class="font-label-md text-label-md">Lista de deseos</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-300 <%= activo === 'pagos' ? 'font-label-md text-label-md text-secondary bg-surface-container-high border-l-2 border-secondary' : 'text-on-surface-variant hover:text-secondary hover:bg-surface-container-highest' %>" href="/pagos">
                <span class="material-symbols-outlined">credit_card</span>
                <span class="font-label-md text-label-md">Métodos de pago</span>
            </a>
            <div class="mt-8 pt-4 border-t border-secondary/10">
                <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-error hover:text-error-container hover:bg-error/10 transition-all duration-300" href="/auth/logout">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="font-label-md text-label-md">Cerrar Sesión</span>
                </a>
            </div>
        </nav>
    </div>
</aside>