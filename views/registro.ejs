<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-surface text-on-surface min-h-screen flex relative flex-col">

<%- include('partials/header') %>

<!-- Decorative background elements -->
<div class="absolute inset-0 z-0 pointer-events-none opacity-30"
     data-alt="A highly sophisticated, cinematic photograph of a luxurious, intimately lit dressing room. Deep, rich shadows contrast with soft, warm golden rim lighting. In the foreground, out of focus, lies a delicate silk garment in dark amethyst."
     style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDY24zXT0kxO5Jm6rOnZbLi9INTTPgTyrgE5JWRxaO3GYFWIbhLfKmSES63z7Uqdvt_YHlHOoI02zDyCqa0Jb0DwH4TPgl-vF1LOlX_uRjhQyouUAF2C9GKJplUimqjK06LIx855LUie0kj_DSNVxuD5khridpFrozpINSFKtg0S4ORasVkzFIVngubLmVHeg34zWrlaMeaMajWA9Nw3MXqmjQ1d49QHjEFwW9Goxzt_OnShlrU8z4'); background-size: cover; background-repeat: no-repeat; background-position: center center; background-attachment: fixed;">
</div>
<div class="relative z-10 w-full max-w-lg px-margin-mobile md:px-0 mx-auto flex-1 flex flex-col justify-center py-6">
    <!-- Registration Card -->
    <div class="glass-panel rounded-xl p-8 shadow-2xl relative">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-8 text-center">Crea tu cuenta</h2>
        <form action="#" class="space-y-6" method="POST">
            <!-- Nombre Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="nombre" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 1px;">Nombre</label>
                    <input
                            class="flex-1 bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                            id="nombre" name="nombre" placeholder="Tu nombre" required="" type="text"></div>
            </div>
            <!-- Apellido Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="apellido" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 1px;">Apellido</label>
                    <input
                            class="flex-1 bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                            id="apellido" name="apellido" placeholder="Tu apellido" required="" type="text"></div>
            </div>

            <!-- Correo Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2"><label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="email" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 1px;">Correo</label>
                    <input
                            class="flex-1 bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                            id="email" name="email" placeholder="correo@ejemplo.com" required="" type="email"></div>
            </div>
            <!-- Contraseña Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="password" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 1px;">Contraseña</label>
                    <div class="flex-1 flex items-center">
                        <input
                                class="w-full bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                                id="password" name="password" placeholder="••••••••" required="" type="password">
                        <button aria-label="Toggle password visibility" id="btnVerContrasena"
                                class="text-on-surface-variant hover:text-secondary transition-colors" type="button">
                            <span id="iconoVisibilidadContrasena" class="material-symbols-outlined"
                                  style="font-variation-settings: 'FILL' 0;">visibility_off</span>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Confirmar contraseña Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2"><label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="confirm_password" style="text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 1px;">Confirmar
                        contraseña</label>
                    <div class="flex-1 flex items-center">
                        <input
                                class="w-full bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                                id="confirm_password" name="confirm_password" placeholder="••••••••" required=""
                                type="password">
                        <button aria-label="Toggle password visibility" id="btnVerConfirmar"
                                class="text-on-surface-variant hover:text-secondary transition-colors" type="button">
                            <span id="iconoVisibilidadConfirmar" class="material-symbols-outlined"
                                  style="font-variation-settings: 'FILL' 0;">visibility_off</span>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Telefono Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label
                            class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                            for="telefono" style="text-shadow: 0px 0px 1px rgba(0,0,0,0.5);">Teléfono</label>
                    <span class="font-body-md">+56 9</span>
                    <input
                            class="flex-1 bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                            id="telefono" name="telefono" placeholder="xxxxxxxx" required="" type="tel"></div>
            </div>
            <!-- Newsletter option -->
            <div class="flex items-start pt-2 gap-3">
                <div class="flex items-center h-5"><input id="newsletter" name="newsletter" type="checkbox"
                                                          class="h-4 w-4 rounded border-surface-variant bg-transparent text-secondary focus:ring-secondary">
                </div>
                <label class="block font-body-md text-body-md text-on-surface-variant cursor-pointer" for="newsletter">Deseo
                    recibir comunicaciones exclusivas, novedades y ofertas de la boutique.</label>
            </div>
            <!-- Crear cuenta button -->
            <div class="pt-4">
                <button class="w-full group relative inline-flex items-center justify-center px-10 py-4 overflow-hidden rounded-full font-label-md text-label-md uppercase tracking-wider text-[#0A0A0A] bg-secondary hover:bg-secondary-fixed transition-colors duration-300 shadow-[0_0_20px_rgba(212,175,55,0.15)] hover:shadow-[0_0_30px_rgba(212,175,55,0.3)]"
                        type="submit">Crear Cuenta
                </button>
            </div>
        </form>
        <!-- Sign In Link -->
        <div class="mt-8 text-center">
            <p class="font-body-md text-body-md text-on-surface-variant">
                ¿Ya tienes una cuenta?
                <a class="font-label-md text-label-md text-secondary hover:text-secondary-fixed ml-1 transition-colors border-b border-transparent hover:border-secondary pb-1"
                   href="/auth/login">
                    Inicia Sesión
                </a>
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
<script src="/javascripts/registro.js"></script>
</body>
</html>