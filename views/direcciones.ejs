<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%-include('partials/head')%>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-lg">
<!-- Top Navigation (Shared Component) -->
<%-include('partials/header')%>
<!-- Main Layout -->
<main class="flex-grow flex flex-col md:flex-row px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full gap-gutter py-12">
    <!-- Sidebar Navigation -->
    <%- include('partials/sidebar-cuenta', { activo: 'direcciones' }) %>
    <!-- Main Content Canvas -->
    <section class="flex-grow flex flex-col gap-8">
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-surface-container-high pb-6">
            <div>
                <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Mis Direcciones</h1>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">Gestiona las direcciones de envío y facturación para tus pedidos.</p>
            </div>
            <a class="group relative inline-flex items-center justify-center px-10 py-4 overflow-hidden rounded-full font-label-md text-label-md uppercase tracking-wider text-[#0A0A0A] bg-secondary hover:bg-secondary-fixed transition-colors duration-300 shadow-[0_0_20px_rgba(212,175,55,0.15)] hover:shadow-[0_0_30px_rgba(212,175,55,0.3)]"
               href="/nueva-direccion">
                <span class="material-symbols-outlined text-sm">add</span>
                <span class="relative flex items-center gap-2">Añadir Nueva Dirección</span>
            </a>
        </header>

        <% if (direcciones.length === 0) { %>
            <div class="glass-panel rounded-xl p-12 flex flex-col items-center justify-center text-center gap-4">
                <span class="material-symbols-outlined text-secondary text-5xl">location_off</span>
                <p class="font-body-md text-body-md text-on-surface-variant">Aún no has agregado ninguna dirección.</p>
                <a href="/nueva-direccion" class="mt-2 font-label-md text-label-md text-secondary hover:text-secondary-fixed underline underline-offset-4 transition-colors">
                    Añadir mi primera dirección
                </a>
            </div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% direcciones.forEach(dir => { %>
            <!-- Address Card -->
            <div class="glass-panel p-6 rounded-lg gold-glow transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
                <div>
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="font-label-md text-label-md <%= dir.predeterminada ? 'text-secondary' : 'text-on-surface' %>">
                            <%= dir.etiqueta %><%= dir.predeterminada ? ' (Principal)' : '' %>
                        </h3>
                        <% if (dir.predeterminada) { %>
                        <span class="bg-secondary/10 text-secondary px-2 py-1 rounded-full font-label-sm text-label-sm border border-secondary/20">Predeterminada</span>
                        <% } %>
                    </div>
                    <address class="not-italic font-body-md text-body-md text-on-surface-variant flex flex-col gap-1">
                        <span><%= dir.direccion %></span>
                        <span>
                            <%= dir.ciudad %><% if (dir.codigo_postal) { %>, <%= dir.codigo_postal %><% } %>
                        </span>
                        <% if (dir.comuna || dir.region) { %>
                        <span><%= [dir.comuna, dir.region].filter(Boolean).join(', ') %></span>
                        <% } %>
                        <% if (dir.telefono) { %>
                        <span class="mt-2 text-on-surface-variant text-sm"><%= dir.telefono %></span>
                        <% } %>
                    </address>
                </div>
                <div class="flex items-center gap-4 mt-8 border-t border-surface-container-high pt-4">
                    <a href="/direcciones/<%= dir.id %>/editar" class="text-secondary hover:text-secondary-fixed font-label-sm text-label-sm uppercase tracking-wider transition-colors">Editar</a>
                    <% if (!dir.predeterminada) { %>
                    <form method="POST" action="/direcciones/<%= dir.id %>/eliminar" class="contents" onsubmit="return confirm('¿Eliminar esta dirección?');">
                        <button type="submit" class="text-on-surface-variant hover:text-error font-label-sm text-label-sm uppercase tracking-wider transition-colors">Eliminar</button>
                    </form>
                    <form method="POST" action="/direcciones/<%= dir.id %>/predeterminada" class="contents">
                        <button type="submit" class="text-on-surface-variant hover:text-secondary font-label-sm text-label-sm uppercase tracking-wider transition-colors ml-auto">Hacer Principal</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </section>
</main>
<!-- Footer (Shared Component) -->
<%-include('partials/footer')%>
</body></html>
