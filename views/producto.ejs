                        <h3 class="font-headline-md text-body-lg text-on-surface mb-1">Funda de Seda</h3>
                        <span class="font-body-md text-body-md text-secondary mb-3">€35.00</span>
                        <button class="text-on-surface hover:text-secondary font-label-sm text-label-sm uppercase flex items-center gap-1 transition-colors">
                            Añadir <span class="material-symbols-outlined text-sm" data-icon="arrow_right_alt">arrow_right_alt</span>
                        </button>
                    </div>
