                    <button aria-label="Color Obsidiana" class="w-10 h-10 rounded-full bg-[#0a0a0a] border border-transparent hover:border-secondary/50 transition-colors"></button>
                    <button aria-label="Color Rojo Carmesí" class="w-10 h-10 rounded-full bg-[#8b0000] border border-transparent hover:border-secondary/50 transition-colors"></button>
                </div>
            </div>
            <!-- Actions -->
