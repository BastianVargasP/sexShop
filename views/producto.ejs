                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-secondary text-sm mt-1" data-icon="circle" data-weight="fill" style="font-variation-settings: 'FILL' 1;">circle</span>
                                Totalmente sumergible (IPX7) para disfrutar en la bañera.
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-secondary text-sm mt-1" data-icon="circle" data-weight="fill" style="font-variation-settings: 'FILL' 1;">circle</span>
                                Batería recargable mediante cable magnético USB.
                            </li>
                        </ul>
                    </div>
                </details>
                <!-- Envío y Devoluciones -->
                <details class="group border-b border-surface-container-highest pb-4">
                    <summary class="flex justify-between items-center cursor-pointer list-none font-headline-md text-body-lg text-on-background hover:text-secondary transition-colors">
                        Envío y Devoluciones
