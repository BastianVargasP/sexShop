<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%-include('partials/head')%>
</head>
<body class="antialiased min-h-screen flex flex-col font-body-md text-body-md overflow-x-hidden selection:bg-secondary selection:text-on-secondary bg-surface">
<!-- TopNavBar -->
<%-include('partials/header')%>
<!-- Main Content -->
<main class="flex-grow pt-14 pb-14 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
    <!-- Product Section -->
    <section class="flex flex-col lg:flex-row gap-gutter md:gap-16 items-start">
        <!-- Image Gallery (Left) -->
        <div class="w-full lg:w-3/5 flex flex-col gap-4">
            <!-- Main Image -->
            <div class="w-full aspect-square md:aspect-[4/5] bg-surface-container rounded-xl overflow-hidden relative group cursor-pointer hover:border hover:border-secondary/20 transition-all duration-300">
                <img alt="<%= producto.nombre %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="<%= producto.imagen %>">
                <!-- Chips -->
                <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
                    <% if (producto.etiqueta) { %>
                    <span class="bg-primary-container text-secondary font-label-sm text-label-sm px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md"><%= producto.etiqueta %></span>
                    <% } %>
                    <span class="bg-surface-container-lowest/80 text-secondary font-label-sm text-label-sm px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md border border-secondary/30">Envío Discreto</span>
                </div>
                <!-- Wishlist FAB -->
                <button type="button" data-favorito-toggle data-producto-id="<%= producto.id %>" data-favorito="<%= esFavorito ? 'true' : 'false' %>"
                        title="<%= esFavorito ? 'Quitar de favoritos' : 'Añadir a favoritos' %>"
                        class="absolute top-4 right-4 h-12 w-12 rounded-full bg-surface-container-lowest/50 backdrop-blur-md border <%= esFavorito ? 'border-secondary text-secondary' : 'border-secondary/20 text-on-surface hover:text-secondary hover:border-secondary' %> flex items-center justify-center transition-all duration-300 z-10">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' <%= esFavorito ? 1 : 0 %>;">favorite</span>
                </button>
            </div>
            <!-- Thumbnails -->
            <div class="flex gap-4 overflow-x-auto hide-scroll pb-2">
                <button class="w-20 md:w-24 aspect-square flex-shrink-0 rounded-lg overflow-hidden border-2 border-secondary bg-surface-container">
                    <img alt="Vista principal" class="w-full h-full object-cover" src="<%= producto.imagen %>">
                </button>
            </div>
        </div>
        <!-- Product Info (Right) -->
        <div class="w-full lg:w-2/5 flex flex-col pt-4 md:pt-8 sticky top-28">
            <% const categoriaLabels = { joyeria: 'Joyería Íntima', estimuladores: 'Estimuladores', cosmetica: 'Cosmética Sensorial', kits: 'Kits Exclusivos' }; %>
            <!-- Brand / Category -->
            <div class="mb-2">
                <span class="font-label-md text-label-md text-secondary tracking-widest uppercase"><%= categoriaLabels[producto.categoria] || producto.categoria %></span>
            </div>
            <!-- Title -->
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"><%= producto.nombre %></h1>
            <!-- Price -->
            <div class="mb-8 mt-4">
                <span class="font-headline-md text-headline-md text-secondary"><%= Number(producto.precio).toFixed(2) %>€</span>
            </div>
            <!-- Description -->
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed">
                <%= producto.descripcion %>
            </p>
            <!-- Actions -->
            <div class="flex flex-col gap-4 mb-12">
                <button class="w-full bg-secondary text-on-secondary font-label-md text-label-md uppercase tracking-wider py-4 rounded-lg hover:bg-secondary-fixed transition-colors font-bold gold-glow flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
                    Añadir al Carrito
                </button>
                <!-- Trust Badges -->
                <div class="flex justify-between items-center py-4 border-t border-b border-surface-container-highest mt-4">
                    <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-secondary" data-icon="local_shipping">local_shipping</span>
                        <span class="font-label-sm text-label-sm">Envío Discreto</span>
                    </div>
                    <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-secondary" data-icon="verified">verified</span>
                        <span class="font-label-sm text-label-sm">15 Años Garantía</span>
                    </div>
                    <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-secondary" data-icon="water_drop">water_drop</span>
                        <span class="font-label-sm text-label-sm">Sumergible IPX7</span>
                    </div>
                </div>
            </div>
            <!-- Accordions for Details -->
            <div class="flex flex-col gap-4">
                <details class="group border-b border-surface-container-highest pb-4" open="">
                    <summary class="flex justify-between items-center cursor-pointer list-none font-headline-md text-body-lg text-on-background hover:text-secondary transition-colors">
                        Descripción
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                    </summary>
                    <div class="pt-4 font-body-md text-body-md text-on-surface-variant">
                        <%= producto.descripcion %>
                    </div>
                </details>
                <details class="group border-b border-surface-container-highest pb-4">
                    <summary class="flex justify-between items-center cursor-pointer list-none font-headline-md text-body-lg text-on-background hover:text-secondary transition-colors">
                        Envío y Devoluciones
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                    </summary>
                    <div class="pt-4 font-body-md text-body-md text-on-surface-variant">
                        Todos nuestros envíos son 100% discretos. El paquete no muestra logotipos ni nombres de marca. Devoluciones aceptadas en los primeros 30 días, siempre que el producto conserve su precinto original de seguridad por motivos de higiene.
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Productos Relacionados -->
    <% if (relacionados.length > 0) { %>
    <section class="mt-20">
        <h2 class="font-headline-md text-headline-md text-on-background mb-12 text-center">Completa tu Experiencia</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% relacionados.forEach(rel => { %>
            <% const relEsFavorito = favoritosIds.has(rel.id); %>
            <div class="producto-card relative rounded-2xl overflow-hidden group border border-surface-container-highest hover:border-secondary/30 transition-all duration-500 bg-surface-container-low flex flex-col">
                <button type="button" data-favorito-toggle data-producto-id="<%= rel.id %>" data-favorito="<%= relEsFavorito ? 'true' : 'false' %>"
                        title="<%= relEsFavorito ? 'Quitar de favoritos' : 'Añadir a favoritos' %>"
                        class="absolute top-4 right-4 z-10 <%= relEsFavorito ? 'text-secondary' : 'text-on-surface-variant hover:text-secondary' %> transition-colors">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' <%= relEsFavorito ? 1 : 0 %>;">favorite</span>
                </button>
                <a href="/producto/<%= rel.id %>" class="block">
                    <div class="relative h-56 w-full overflow-hidden bg-surface-container-lowest">
                        <img alt="<%= rel.nombre %>" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="<%= rel.imagen %>">
                    </div>
                    <div class="p-6">
                        <% if (rel.etiqueta) { %>
                        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-2 block"><%= rel.etiqueta %></span>
                        <% } %>
                        <h3 class="font-headline-md text-headline-md text-on-surface mb-2"><%= rel.nombre %></h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4 line-clamp-2"><%= rel.descripcion_corta %></p>
                        <span class="font-headline-md text-body-lg text-secondary"><%= Number(rel.precio).toFixed(2) %>€</span>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </section>
    <% } %>
</main>
<!-- Footer -->
<%-include('partials/footer')%>
<script src="/javascripts/favoritos.js"></script>

</body>
</html>
