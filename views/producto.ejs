                    <span class="bg-primary-container text-secondary font-label-sm text-label-sm px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md">Best Seller</span>
                    <span class="bg-surface-container-lowest/80 text-secondary font-label-sm text-label-sm px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md border border-secondary/30">Envío Gratis</span>
                </div>
                <!-- Wishlist FAB -->
                <button id="btnWishlist" class="absolute top-4 right-4 h-12 w-12 rounded-full bg-surface-container-lowest/50 backdrop-blur-md border border-secondary/20 flex items-center justify-center text-on-surface hover:text-secondary hover:border-secondary transition-all duration-300 z-10">
