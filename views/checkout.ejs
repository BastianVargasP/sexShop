<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%-include('partials/head')%>
</head>
<body class="bg-background text-on-surface font-body-md min-h-screen selection:bg-secondary selection:text-surface-lowest flex flex-col">
<!-- TopNavBar -->
<%-include('partials/header')%>
<main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-6">
    <header class="mb-6 text-center md:text-left border-b border-surface-container-high pb-2">
        <h1 class="font-headline-xl text-headline-xl text-on-surface mb-2">Checkout</h1>
    </header>
    <form action="/checkout" method="POST">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter lg:gap-16">
            <!-- Left Column: Selección de dirección y pago -->
            <div class="lg:col-span-7 space-y-12">
                <!-- Shipping Section -->
                <section class="card-glass p-8 rounded-xl glass-panel rounded-xl top-28 bg-surface-container">
                    <div class="flex items-center gap-4 mb-8">
                    <span class="material-symbols-outlined text-secondary text-3xl"
                          style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Dirección de Envío</h2>
                    </div>

                    <% if (direcciones.length === 0) { %>
                        <div class="p-4 border border-secondary/30 bg-primary-container/10 rounded-lg text-on-surface-variant">
                            Aún no tienes direcciones guardadas.
                            <a href="/nueva-direccion" class="text-secondary hover:underline">Añade una dirección</a> para continuar.
                        </div>
                    <% } else { %>
                        <div class="space-y-4">
                            <% const hayPredeterminadaDir = direcciones.some(d => d.predeterminada); %>
                            <% direcciones.forEach((dir, index) => { %>
                                <label class="block cursor-pointer">
                                    <div class="flex items-start gap-4 p-4 border border-outline-variant rounded-lg bg-surface-container-low hover:border-secondary transition-colors has-[:checked]:border-secondary has-[:checked]:bg-primary-container/10">
                                        <input type="radio" name="direccionId" value="<%= dir.id %>"
                                                <%= (dir.predeterminada || (index === 0 && !hayPredeterminadaDir)) ? 'checked' : '' %>
                                               class="form-radio mt-1 text-secondary bg-transparent border-outline-variant focus:ring-secondary w-4 h-4" required/>
                                        <div class="flex-grow">
                                            <p class="font-label-md text-on-surface"><%= dir.etiqueta %></p>
                                            <p class="text-sm text-on-surface-variant"><%= dir.direccion %></p>
                                            <p class="text-sm text-on-surface-variant">
                                                <%= dir.ciudad %><% if (dir.codigo_postal) { %>, <%= dir.codigo_postal %><% } %>
                                            </p>
                                        </div>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <!-- Payment Section -->
                <section class="card-glass p-8 rounded-xl glass-panel rounded-xl top-28 bg-surface-container">
                    <div class="flex items-center gap-4 mb-8">
                    <span class="material-symbols-outlined text-secondary text-3xl"
                          style="font-variation-settings: 'FILL' 1;">payment</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Método de Pago</h2>
                    </div>

                    <% if (metodosPago.length === 0) { %>
                        <div class="p-4 border border-secondary/30 bg-primary-container/10 rounded-lg text-on-surface-variant">
                            Aún no tienes métodos de pago guardados.
                            <a href="/nuevo-metodo-pago" class="text-secondary hover:underline">Añade un método de pago</a> para continuar.
                        </div>
                    <% } else { %>
                        <div class="space-y-4">
                            <% const hayPredeterminadoPago = metodosPago.some(m => m.predeterminada); %>
                            <% metodosPago.forEach((metodo, index) => { %>
                                <label class="block cursor-pointer">
                                    <div class="flex items-center gap-4 p-4 border border-outline-variant rounded-lg bg-surface-container-low hover:border-secondary transition-colors has-[:checked]:border-secondary has-[:checked]:bg-primary-container/10">
                                        <input type="radio" name="metodoPagoId" value="<%= metodo.id %>"
                                                <%= (metodo.predeterminada || (index === 0 && !hayPredeterminadoPago)) ? 'checked' : '' %>
                                               class="form-radio text-secondary bg-transparent border-outline-variant focus:ring-secondary w-5 h-5" required/>
                                        <span class="material-symbols-outlined text-on-surface-variant">credit_card</span>
                                        <div class="flex-grow">
                                            <p class="font-label-md text-on-surface"><%= metodo.marca %> terminada en <%= metodo.ultimos_digitos %></p>
                                            <p class="text-sm text-on-surface-variant">Expira <%= metodo.vencimiento %></p>
                                        </div>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    <% } %>
                </section>
            </div>

            <!-- Right Column: Order Summary (Sticky) -->
            <div class="lg:col-span-5 relative glass-panel rounded-xl golden-glow transition-all duration-300 group overflow-hidden">
                <div class="sticky top-8 card-glass p-8 rounded-xl shadow-lg shadow-black/50">
                    <h2 class="font-headline-md text-headline-md text-secondary mb-6 border-b border-surface-container-high pb-4">
                        Resumen del Pedido</h2>
                    <!-- Items -->
                    <div class="space-y-6 mb-8 max-h-[40vh] overflow-y-auto pr-2 custom-scrollbar">
                        <% items.forEach(item => { %>
                            <div class="flex items-start gap-4">
                                <div class="w-20 h-24 bg-surface-container-high rounded flex-shrink-0 overflow-hidden border border-outline-variant/30">
                                    <img class="w-full h-full object-cover" src="<%= item.imagen %>" alt="<%= item.nombre %>"/>
                                </div>
                                <div class="flex-grow">
                                    <h3 class="font-label-md text-label-md text-on-surface mb-1"><%= item.nombre %></h3>
                                    <p class="font-body-md text-sm text-on-surface-variant mb-2"><%= item.descripcion_corta %></p>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-outline">Cant: <%= item.cantidad %></span>
                                        <span class="font-label-md text-label-md text-secondary">
                                    <%= formatearCLP(Number(item.precio) * item.cantidad) %>
                                </span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <!-- Totals -->
                    <div class="border-t border-surface-container-high pt-6 space-y-4">
                        <div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
                            <span>Subtotal</span>
                            <span><%= formatearCLP(subtotal) %></span>
                        </div>
                        <div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
                            <span>Envío Express</span>
                            <span><%= formatearCLP(envio) %></span>
                        </div>
                        <div class="flex justify-between font-headline-md text-xl text-secondary pt-4 border-t border-surface-container-high mt-4">
                            <span>Total</span>
                            <span><%= formatearCLP(total) %></span>
                        </div>
                    </div>
                    <!-- Action -->
                    <button type="submit"
                            <%= (direcciones.length === 0 || metodosPago.length === 0) ? 'disabled' : '' %>
                            class="w-full bg-secondary text-on-secondary-container font-label-md text-label-md py-4 rounded-md uppercase tracking-widest font-bold hover:bg-secondary-fixed transition-colors mt-4 flex justify-center items-center gap-2 group disabled:opacity-50 disabled:cursor-not-allowed">
                        Completar Pago
                        <span class="material-symbols-outlined text-sm">lock</span>
                    </button>
                    <p class="text-center font-label-sm text-label-sm text-outline mt-4">
                        Al completar el pago, aceptas nuestros <a class="text-secondary hover:underline"
                                                                  href="#">Términos</a> y
                        class="text-secondary hover:underline" href="#">Política de Privacidad</a>.
                    </p>
                </div>
            </div>
        </div>
    </form>
</main>
<!-- Footer -->
<%-include('partials/footer')%>
</body>
</html>