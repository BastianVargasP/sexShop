<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-lg">
<!-- TopNavBar -->
<%- include('partials/header') %>
<!-- Main Content Canvas -->
<main class="flex-grow w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-12">
    <!-- Header -->
    <div class="mb-6 border-b border-surface-variant pb-4">
        <div class="flex justify-between items-center">
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">Detalles del Pedido</h1>
            <a href="/pedidos" class="inline-flex items-center gap-2 px-4 py-2 border border-secondary text-secondary font-label-md text-label-md uppercase tracking-widest hover:bg-secondary hover:text-on-secondary transition-colors duration-300 rounded">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Volver a mis pedidos
            </a>
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <p class="font-body-lg text-body-lg text-on-surface-variant">Pedido #LX-89042 <span class="mx-2 text-surface-variant">|</span> 12 Oct 2023</p>

            <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-container/20 border border-primary/30 rounded-full">
                <span class="material-symbols-outlined text-primary fill text-[18px]">check_circle</span>
                <span class="font-label-md text-label-md text-primary">Entregado</span>
            </div>
        </div>
    </div>
    <!-- Tracking Bar (Glassmorphism card) -->
    <div class="bg-surface-container-high/40 backdrop-blur-md rounded-xl p-8 mb-6 border border-secondary/10 relative overflow-hidden">
        <!-- Subtle glow effect -->
        <div class="absolute inset-0 bg-secondary/5 blur-3xl rounded-full opacity-50 w-1/2 h-full top-0 left-1/4 pointer-events-none"></div>
        <div class="relative z-10">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-8">Estado de Envío</h2>
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center relative">
                <!-- Progress Line (Desktop) -->
                <div class="hidden md:block absolute top-1/2 left-[4%] right-[4%] h-[2px] bg-surface-variant -z-10 -translate-y-[1.25rem]">
                    <div class="h-full bg-secondary w-full"></div>
                </div>
                <!-- Progress Line (Mobile) -->
                <div class="md:hidden absolute left-5 top-8 bottom-8 w-[2px] bg-secondary -z-10"></div>
                <!-- Steps -->
                <div class="flex flex-row md:flex-col items-center gap-4 md:gap-2 mb-8 md:mb-0 w-full md:w-auto relative z-10">
                    <div class="w-10 h-10 rounded-full bg-secondary text-on-secondary flex items-center justify-center border-4 border-surface-container-high">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                    </div>
                    <div class="flex flex-col md:items-center">
                        <span class="font-label-md text-label-md text-on-surface">Realizado</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">12 Oct</span>
                    </div>
                </div>
                <div class="flex flex-row md:flex-col items-center gap-4 md:gap-2 mb-8 md:mb-0 w-full md:w-auto relative z-10">
                    <div class="w-10 h-10 rounded-full bg-secondary text-on-secondary flex items-center justify-center border-4 border-surface-container-high">
                        <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                    </div>
                    <div class="flex flex-col md:items-center">
                        <span class="font-label-md text-label-md text-on-surface">Procesado</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">13 Oct</span>
                    </div>
                </div>
                <div class="flex flex-row md:flex-col items-center gap-4 md:gap-2 mb-8 md:mb-0 w-full md:w-auto relative z-10">
                    <div class="w-10 h-10 rounded-full bg-secondary text-on-secondary flex items-center justify-center border-4 border-surface-container-high">
                        <span class="material-symbols-outlined text-[20px]">local_shipping</span>
                    </div>
                    <div class="flex flex-col md:items-center">
                        <span class="font-label-md text-label-md text-on-surface">Enviado</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">14 Oct</span>
                    </div>
                </div>
                <div class="flex flex-row md:flex-col items-center gap-4 md:gap-2 w-full md:w-auto relative z-10">
                    <div class="w-10 h-10 rounded-full bg-secondary text-on-secondary flex items-center justify-center border-4 border-surface-container-high shadow-[0_0_15px_rgba(212,175,55,0.4)]">
                        <span class="material-symbols-outlined text-[20px]">home</span>
                    </div>
                    <div class="flex flex-col md:items-center">
                        <span class="font-label-md text-label-md text-secondary">Entregado</span>
                        <span class="font-label-sm text-label-sm text-secondary">15 Oct</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Items (Bento Style) -->
        <div class="lg:col-span-2 space-y-6">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-6">Artículos Comprados</h2>
            <!-- Item 1 -->
            <div class="group flex flex-col sm:flex-row gap-6 bg-surface-container-low p-4 rounded-xl border border-transparent hover:border-secondary/20 transition-all duration-300 relative overflow-hidden">
                <div class="w-full sm:w-32 h-32 rounded-lg bg-surface flex-shrink-0 relative overflow-hidden">
                    <img class="absolute inset-0 w-full h-full object-cover" data-alt="A luxurious, high-end cosmetic bottle of 'Elixir Nocturno' sitting on a polished black obsidian surface. Soft, dramatic studio lighting highlights the sleek lines of the glass bottle and the subtle golden accents on its cap. The background is completely dark, creating a moody, exclusive atmosphere consistent with a premium boutique visual style. The aesthetic is sophisticated, minimalist, and deeply elegant, emphasizing the intimate luxury of the product." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDN57XSiikCPN95Rq2jwDlStgVua0GqzmnYbF_5XkPOkRz2Y3fPkxxY5xK3yBEkGDFwQP_IGE5qFwzaxdJ6-FI7stORi2oZJI5SxM-V7vgQigSMuA8Mnsel1EYtuxgJiOzbFul5kDI3oUG7e2J0kCY5RlA0tzfG2i6N3yTSKFnOVtTycvxI1SGXyTjYnsYKLH6CLsiYik_ACz7svOC1EO0BA57sTy1i4htnGCSvI8mPSM8_khzxbME"/>
                </div>
                <div class="flex-grow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-headline-md text-[24px] text-on-surface">Elixir Nocturno</h3>
                            <p class="font-body-md text-body-md text-secondary font-medium">145,00 €</p>
                        </div>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4">Sérum revitalizante intenso. Edición limitada.</p>
                    </div>
                    <div class="flex items-center text-on-surface-variant">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Cant: 1</span>
                    </div>
                </div>
            </div>
            <!-- Item 2 -->
            <div class="group flex flex-col sm:flex-row gap-6 bg-surface-container-low p-4 rounded-xl border border-transparent hover:border-secondary/20 transition-all duration-300 relative overflow-hidden">
                <div class="w-full sm:w-32 h-32 rounded-lg bg-surface flex-shrink-0 relative overflow-hidden">
                    <img class="absolute inset-0 w-full h-full object-cover" data-alt="A sleek, minimalist jar of 'Sculpt Aura' body cream presented on a dark, textured slate pedestal. The lighting is low-key with a subtle golden rim light catching the edge of the jar, evoking a sense of mysterious luxury and exclusivity. The background falls off into deep black, maintaining the premium glassmorphism and minimalist aesthetic of a high-end wellness brand. The overall mood is serene, refined, and highly sophisticated." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBdD593fGw6Nuu1WuWt96VLWJSm3DvbaCa7BLFIUvOJ0ASqQXOeiqU0DmYEpU0OTu2JnF_V_RewAtudadJu4f_JZVHy3Uvfy2C2zjoPV2VJ1GxHiNJZh4RsTVnOh164EsMyEG9FMHSNYo6E0MJY26EmUaP-JCGWI7jJU-Bm5YLXNsvOgVog8Kw3yBNU4wA_PATiii-Ptfhf2lQ-t30_6hYzoDiwihX-m-6_lt6I8qA-OKd4ArWY8ZQ"/>
                </div>
                <div class="flex-grow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-headline-md text-[24px] text-on-surface">Sculpt Aura</h3>
                            <p class="font-body-md text-body-md text-secondary font-medium">85,00 €</p>
                        </div>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4">Crema corporal reafirmante con extracto de loto negro.</p>
                    </div>
                    <div class="flex items-center text-on-surface-variant">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Cant: 2</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Right Column: Details & Summary -->
        <div class="space-y-8">
            <!-- Order Summary Card -->
            <div class="bg-surface-container-high/60 backdrop-blur-md rounded-xl p-6 border border-secondary/10">
                <h3 class="font-headline-md text-[24px] text-on-surface mb-6">Resumen</h3>
                <div class="space-y-4 font-body-md text-body-md text-on-surface-variant border-b border-surface-variant pb-6 mb-6">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span>315,00 €</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Envío (Express)</span>
                        <span>15,00 €</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Impuestos incl.</span>
                        <span>66,15 €</span>
                    </div>
                </div>
                <div class="flex justify-between items-center mb-8">
                    <span class="font-body-lg text-body-lg text-on-surface">Total</span>
                    <span class="font-headline-md text-headline-md text-secondary">330,00 €</span>
                </div>
                <button class="w-full py-4 bg-transparent border border-secondary text-secondary font-label-md text-label-md uppercase tracking-widest hover:bg-secondary hover:text-on-secondary transition-colors duration-300 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    Descargar Factura
                </button>
            </div>
            <!-- Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6">
                <!-- Shipping -->
                <div class="bg-surface-container-low p-6 rounded-xl border border-surface-variant">
                    <div class="flex items-center gap-3 mb-4 text-secondary">
                        <span class="material-symbols-outlined">location_on</span>
                        <h4 class="font-label-md text-label-md uppercase tracking-wider">Dirección de Entrega</h4>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        Isabella Rossi<br/>
                        Calle de Serrano 45, Piso 3A<br/>
                        28001 Madrid<br/>
                        España
                    </p>
                </div>
                <!-- Payment -->
                <div class="bg-surface-container-low p-6 rounded-xl border border-surface-variant">
                    <div class="flex items-center gap-3 mb-4 text-secondary">
                        <span class="material-symbols-outlined">credit_card</span>
                        <h4 class="font-label-md text-label-md uppercase tracking-wider">Método de Pago</h4>
                    </div>
                    <div class="flex items-center gap-3 font-body-md text-body-md text-on-surface-variant">
                        <div class="w-10 h-6 bg-surface rounded border border-surface-variant flex items-center justify-center text-xs font-bold text-on-surface">VISA</div>
                        <span>**** **** **** 4242</span>
                    </div>
                </div>
            </div>
            <!-- Help -->
            <div class="pt-4 flex flex-col items-center justify-center text-center">
                <p class="font-body-md text-body-md text-on-surface-variant mb-4">¿Necesitas ayuda con tu pedido?</p>
                <a class="inline-flex items-center gap-2 font-label-md text-label-md text-secondary hover:text-primary transition-colors underline underline-offset-4" href="#">
                    Contactar Soporte
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>
</main>
<!-- Footer -->
<%- include('partials/footer') %>
</body></html>