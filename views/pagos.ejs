<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-lg">
<!-- TopNavBar -->
<%- include('partials/header') %>
<!-- Main Content -->
<main class="flex-grow flex flex-col md:flex-row px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full gap-gutter py-12">
    <!-- Sidebar -->
    <%- include('partials/sidebar-cuenta', { activo: 'pagos' }) %>
    <!-- Content Area -->
    <section class="w-full md:w-3/4 flex flex-col">
        <header class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-surface-container-high pb-6">
            <div>
                <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background">
                    Métodos de Pago</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Gestiona tus tarjetas y cuentas
                    para una experiencia de compra fluida y segura.</p>
            </div>
            <a href="/nuevo-metodo-pago" class="bg-secondary text-background font-label-md text-label-md px-6 py-3 rounded-DEFAULT hover:bg-secondary-fixed-dim transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">add</span>
                Añadir Nuevo Método
            </a>
        </header>

        <% if (metodosPago.length === 0) { %>
            <div class="glass-panel rounded-xl p-12 flex flex-col items-center justify-center text-center gap-4">
                <span class="material-symbols-outlined text-secondary text-5xl">credit_card_off</span>
                <p class="font-body-md text-body-md text-on-surface-variant">Aún no has agregado ningún método de pago.</p>
                <a href="/nuevo-metodo-pago" class="mt-2 font-label-md text-label-md text-secondary hover:text-secondary-fixed underline underline-offset-4 transition-colors">
                    Añadir mi primer método
                </a>
            </div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% metodosPago.forEach(metodo => { %>
            <!-- Payment Card -->
            <div class="glass-panel rounded-xl p-8 golden-glow transition-all duration-300 relative group overflow-hidden flex flex-col min-h-[220px] justify-between">
                <div class="absolute inset-0 opacity-10 bg-cover bg-center pointer-events-none mix-blend-overlay"
                     style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCvQaa9UwsA_JmoRH-ld5uvSIIJRXzmotUWOp6QMF9ovUo5spr_56YusYQ5VXxDyVzV3Q1iF8W2DJd_hf2zRqrwhBS9GEqGHhH_3F7pr9SBQ6Pl2BC8dHO02utykpUOtDPWq1vkasHF3UHMYtOWz3SnR2n7wyoOwt6gT3LbgRLcCMY2XPbeS2l1LUoWJhzla8bd8VlDcbmknMe5itK_DaGGq5aB-VMDlrbE5luwumkv7M5W1Fe1fis')"></div>
                <div class="relative z-10 flex justify-between items-start">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-8 bg-white/90 rounded flex items-center justify-center p-1">
                            <% if (metodo.marca && metodo.marca.toLowerCase() === 'visa') { %>
                            <svg class="w-full h-full fill-blue-900" viewBox="0 0 50 16">
                                <path d="M18.8 15.6l3.3-15.6h-5.4L13.4 15.6h5.4zm-14.7 0L0 0h5.2l2.3 8.3 3.6-8.3h5.2l-6.8 15.6H4.1zm24.6-11.4c-1-1-2.9-1.5-4.8-1.5-5 0-8.5 2.5-8.5 6.2 0 2.7 2.5 4.3 4.4 5.2 2 .9 2.6 1.5 2.6 2.3 0 1.2-1.6 1.8-3 1.8-1.7 0-3.1-.4-4.2-1l-1.3-.6-.7 4.2c1.2.5 3.3 1 5.3 1 5.5 0 8.9-2.6 8.9-6.4 0-2.2-1.3-3.9-4.2-5.3-1.8-.9-2.8-1.5-2.8-2.3 0-.7.9-1.5 2.7-1.5 1.4 0 2.6.3 3.5.7l1.1.5.8-3.6zm15.1 11.4h4.9l-4.1-15.6h-3.9c-.9 0-1.7.5-2 1.3l-5.6 14.3h5.2l1-2.8h6.4l.5 2.8zM42.2 10l1.6-4.5 1.1 4.5h-2.7z"></path>
                            </svg>
                            <% } else { %>
                            <span class="material-symbols-outlined text-blue-900 text-xl">credit_card</span>
                            <% } %>
                        </div>
                        <% if (metodo.marca) { %>
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"><%= metodo.marca %></span>
                        <% } %>
                        <% if (metodo.predeterminada) { %>
                        <span class="font-label-sm text-label-sm text-secondary border border-secondary/30 px-2 py-0.5 rounded text-[10px] uppercase tracking-wider">Predeterminado</span>
                        <% } %>
                    </div>
                    <div class="flex gap-3">
                        <a aria-label="Editar" href="/pagos/<%= metodo.id %>/editar"
                                class="text-on-surface-variant hover:text-secondary flex items-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-[20px]">edit</span>
                            <span class="text-[10px] uppercase font-label-sm">Editar</span>
                        </a>
                        <form method="POST" action="/pagos/<%= metodo.id %>/eliminar" class="contents" onsubmit="return confirm('¿Eliminar este método de pago?');">
                            <button type="submit" aria-label="Eliminar"
                                    class="text-on-surface-variant hover:text-error flex items-center gap-1 transition-colors">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                <span class="text-[10px] uppercase font-label-sm">Eliminar</span>
                            </button>
                        </form>
                    </div>
                </div>
                <div class="relative z-10 flex flex-col gap-4">
                    <span class="font-body-lg text-body-lg text-on-surface tracking-[0.2em] text-xl">**** **** **** <%= metodo.ultimos_digitos %></span>
                    <div class="flex items-center gap-24">
                        <div class="flex justify-between items-end">
                            <div>
                                <span class="block font-label-sm text-label-sm text-on-surface-variant/70 mb-1 uppercase tracking-widest">Válida hasta</span>
                                <span class="font-body-md text-body-md text-on-surface"><%= metodo.vencimiento %></span>
                            </div>
                        </div>
                        <div class="flex justify-between items-end">
                            <div>
                                <span class="block font-label-sm text-label-sm text-on-surface-variant/70 mb-1 uppercase tracking-widest">CVV</span>
                                <span class="font-body-md text-body-md text-on-surface">***</span>
                            </div>
                        </div>
                    </div>
                    <% if (!metodo.predeterminada) { %>
                    <form method="POST" action="/pagos/<%= metodo.id %>/predeterminada" class="mt-2">
                        <button type="submit" class="text-on-surface-variant hover:text-secondary font-label-sm text-label-sm uppercase tracking-wider transition-colors">Hacer Predeterminado</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
        <!-- Informational Section -->
        <div class="mt-12 bg-surface-container-high/50 rounded-xl p-6 border border-surface-container-highest flex items-start gap-4">
            <span class="material-symbols-outlined text-secondary mt-1">shield_lock</span>
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">Pago Seguro</h3>
                <p class="font-body-md text-body-md text-on-surface-variant text-sm">Toda la información de tus métodos
                    de pago está encriptada y almacenada de forma segura. Luxuria &amp; Sentido no guarda los datos
                    completos de tus tarjetas.</p>
            </div>
        </div>
    </section>
</main>
<!-- Footer -->
<%- include('partials/footer') %>


</body>
</html>
