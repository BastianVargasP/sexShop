<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col font-body-lg">
<!-- TopNavBar -->
<%- include('partials/header') %>
<!-- Main Content Layout -->
<main class="flex-grow flex flex-col md:flex-row px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full gap-gutter py-12">
    <!-- Sidebar Navigation -->
    <%- include('partials/sidebar-cuenta', { activo: 'pedidos' }) %>
    <!-- Main Area: Order History -->
    <section class="flex-grow flex flex-col gap-8">
        <div class="border-b border-secondary/10 pb-4">
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">
                Historial de Pedidos</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-2">Revisa el estado y los detalles de tus
                compras recientes.</p>
        </div>
        <!-- Orders List -->
        <div class="flex flex-col gap-4">
            <% if (pedidos.length === 0) { %>
                <p class="font-body-md text-body-md text-on-surface-variant text-center py-12">Aún no tienes pedidos
                    realizados.</p>
            <% } else { %>
                <% pedidos.forEach(pedido => { %>
                    <article
                            class="glass-panel rounded-xl p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:border-secondary/40 transition-colors duration-300">
                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded bg-surface-container-highest border border-secondary/20 flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-[32px]">
                        <%= pedido.estado === 'entregado' ? 'local_shipping' : pedido.estado === 'devuelto' ? 'assignment_return' : 'inventory_2' %>
                    </span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="font-label-md text-label-md text-secondary">#<%= pedido.numero_pedido %></span>
                                <span class="font-body-md text-[14px] text-on-surface-variant">Realizado el <%= new Date(pedido.created_at).toLocaleDateString('es-CL', {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric'
                                    }) %></span>
                            </div>
                        </div>
                        <div class="flex flex-col md:items-end gap-2 w-full md:w-auto border-t md:border-t-0 border-secondary/10 pt-4 md:pt-0">
                            <div class="flex items-center justify-between md:justify-end gap-6 w-full">
                                <span class="font-headline-md text-[20px] text-on-surface"><%= formatearCLP(pedido.total) %></span>
                                <span class="font-label-sm text-label-sm px-3 py-1 bg-secondary/10 text-secondary rounded border border-secondary/30 flex items-center gap-1 capitalize">
                        <span class="material-symbols-outlined text-[14px]">check_circle</span> <%= pedido.estado %>
                    </span>
                            </div>
                            <a href="/pedido/<%= pedido.id %>"
                               class="w-full md:w-auto mt-2 px-6 py-2 border border-secondary text-secondary rounded font-label-md text-label-md hover:bg-secondary hover:text-background transition-colors duration-300">
                                Ver Detalles
                            </a>
                        </div>
                    </article>
                <% }) %>
            <% } %>
        </div>
    </section>
</main>
<!-- Footer -->
<%- include('partials/footer') %>
</body>
</html>