<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%- include('../partials/admin/head', { titulo: 'Inventario' }) %>
</head>
<body class="bg-surface-container-lowest text-on-surface font-body-md text-body-md">

<!-- Topbar móvil -->
<%- include('../partials/admin/mobile-topbar') %>

<!-- Sidebar -->
<%- include('../partials/admin/sidebar', { activo: 'inventario', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<div class="pl-64">
    <main class="relative bg-surface-container-lowest min-h-screen px-8 py-8">
        <div class="flex flex-col w-full space-y-8 pb-16">
            <!-- 1. Encabezado de Página -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div class="space-y-2">
<span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-secondary flex items-center gap-2">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
        MÓDULO DE CONTROL DE EXISTENCIAS &amp; TRAZABILIDAD
      </span>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                        Gestión de Inventario
                    </h1>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
                        Supervisión de existencias en tiempo real, reservas de pedidos y auditoría estricta de
                        movimientos.
                    </p>
                </div>
                <!-- Indicador de Sincronización en Vivo -->
                <div class="flex items-center gap-3 px-4 py-2 rounded-lg bg-surface-container-low shadow-sm">
<span class="relative flex h-2.5 w-2.5">
<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary"></span>
</span>
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Bodega Principal (Madrid)</span>
                        <span class="font-label-md text-label-md text-on-surface">Sincronizado hace 2 min</span>
                    </div>
                </div>
            </div>
            <!-- 2. Barra de Métricas Rápidas / Indicadores de Stock -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <!-- Métricas: Disponible -->
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between transition-all duration-300 hover:bg-surface-container">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Disponible</span>
                        <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm flex items-center gap-1.5">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Óptimo
        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-on-surface">1.480</span>
                        <span class="font-label-sm text-label-sm text-outline">Unidades netas</span>
                    </div>
                    <div class="mt-3 w-full bg-surface-container-highest rounded-full h-1 overflow-hidden">
                        <div class="bg-secondary h-full rounded-full w-[88%]"></div>
                    </div>
                </div>
                <!-- Métricas: Stock Bajo -->
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between transition-all duration-300 hover:bg-surface-container">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Stock Bajo</span>
                        <span class="px-2.5 py-1 rounded-full bg-secondary-container/40 text-secondary-fixed font-label-sm text-label-sm flex items-center gap-1.5">
<span class="material-symbols-outlined text-[14px]">warning</span> Atención
        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-secondary-fixed">18</span>
                        <span class="font-label-sm text-label-sm text-outline">8 referencias</span>
                    </div>
                    <div class="mt-3 w-full bg-surface-container-highest rounded-full h-1 overflow-hidden">
                        <div class="bg-secondary-fixed h-full rounded-full w-[24%]"></div>
                    </div>
                </div>
                <!-- Métricas: Stock Crítico -->
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between transition-all duration-300 hover:bg-surface-container">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Stock Crítico</span>
                        <span class="px-2.5 py-1 rounded-full bg-error-container/40 text-error font-label-sm text-label-sm flex items-center gap-1.5">
<span class="material-symbols-outlined text-[14px]">priority_high</span> Urgente
        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-error">5</span>
                        <span class="font-label-sm text-label-sm text-outline">Por agotar hoy</span>
                    </div>
                    <div class="mt-3 w-full bg-surface-container-highest rounded-full h-1 overflow-hidden">
                        <div class="bg-error h-full rounded-full w-[12%]"></div>
                    </div>
                </div>
                <!-- Métricas: Agotado -->
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between transition-all duration-300 hover:bg-surface-container">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Agotado</span>
                        <span class="px-2.5 py-1 rounded-full bg-surface-container-highest text-outline font-label-sm text-label-sm flex items-center gap-1.5">
<span class="material-symbols-outlined text-[14px]">block</span> Alerta
        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-outline">3</span>
                        <span class="font-label-sm text-label-sm text-outline">Variantes en cero</span>
                    </div>
                    <div class="mt-3 w-full bg-surface-container-highest rounded-full h-1 overflow-hidden">
                        <div class="bg-outline h-full rounded-full w-[100%]"></div>
                    </div>
                </div>
            </div>
            <!-- 3. Pestañas Principales y Botones de Acción Global -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pt-2">
                <!-- Pestañas -->
                <div class="flex items-center p-1.5 bg-surface-container-low rounded-xl w-fit">
                    <button class="flex items-center gap-2.5 px-5 py-2.5 rounded-lg font-label-md text-label-md transition-all text-on-surface-variant"
                            id="tab-existencias" onclick="switchView('existencias')">
                        <span class="material-symbols-outlined text-[18px]">inventory</span>
                        <span class="">Listado de Existencias</span>
                        <span class="ml-1 px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm">124</span>
                    </button>
                    <button class="flex items-center gap-2.5 px-5 py-2.5 rounded-lg hover:text-on-surface font-label-md text-label-md transition-all bg-surface-container text-secondary shadow-sm"
                            id="tab-movimientos" onclick="switchView('movimientos')">
                        <span class="material-symbols-outlined text-[18px]">history</span>
                        <span class="">Movimientos de Inventario</span>
                        <span class="flex h-2 w-2 rounded-full bg-secondary"></span>
                    </button>
                </div>
                <!-- Botones de Acción Rápida -->
                <div class="flex flex-wrap items-center gap-3">
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-secondary text-on-secondary font-label-md text-label-md font-bold transition-all hover:bg-secondary-fixed shadow-md"
                            onclick="openModal('Entrada manual')">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        <span class="">+ Agregar Stock</span>
                    </button>
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright font-label-md text-label-md transition-all"
                            onclick="openModal('Ajuste')">
                        <span class="material-symbols-outlined text-[18px]">tune</span>
                        <span class="">Ajustar Stock</span>
                    </button>
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright font-label-md text-label-md transition-all"
                            onclick="openModal('Salida manual')">
                        <span class="material-symbols-outlined text-[18px]">remove</span>
                        <span class="">Descontar Stock</span>
                    </button>
                    <button class="flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all"
                            title="Exportar Reporte Excel / CSV">
                        <span class="material-symbols-outlined text-[20px]">ios_share</span>
                    </button>
                </div>
            </div>
            <!-- CONTENEDOR: VISTA 1 - LISTADO DE EXISTENCIAS -->
            <div class="space-y-6 hidden" id="view-existencias">
                <!-- 4. Filtros de Búsqueda y Selección -->
                <div class="p-5 rounded-xl bg-surface-container-low shadow-sm">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                        <!-- Búsqueda textual -->
                        <div class="md:col-span-5 relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                            <input class="w-full bg-surface-container rounded-lg pl-10 pr-4 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-secondary transition-all"
                                   placeholder="Buscar por producto, variante o SKU..." type="text">
                        </div>
                        <!-- Selector de Estado -->
                        <div class="md:col-span-3">
                            <select class="w-full bg-surface-container rounded-lg px-4 py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all cursor-pointer">
                                <option value="all">Todos los estados</option>
                                <option value="critico">Stock Crítico</option>
                                <option value="bajo">Stock Bajo</option>
                                <option value="agotado">Agotado</option>
                                <option value="disponible">Disponible</option>
                            </select>
                        </div>
                        <!-- Selector de Categoría -->
                        <div class="md:col-span-2">
                            <select class="w-full bg-surface-container rounded-lg px-4 py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all cursor-pointer">
                                <option value="all">Colecciones</option>
                                <option value="lenceria">Alta Lencería</option>
                                <option value="bienestar">Wellness &amp; Tacto</option>
                                <option value="aromas">Aromaterapia &amp; Ceras</option>
                                <option value="accesorios">Cuero &amp; Joyería</option>
                            </select>
                        </div>
                        <!-- Botones de Filtrado -->
                        <div class="md:col-span-2 flex items-center justify-end gap-2">
                            <button class="px-4 py-2.5 rounded-lg bg-secondary text-on-secondary font-label-md text-label-md font-semibold hover:bg-secondary-fixed transition-colors">
                                Filtrar
                            </button>
                            <button class="px-3 py-2.5 rounded-lg text-outline hover:text-on-surface font-label-sm text-label-sm uppercase tracking-wider transition-colors">
                                Limpiar
                            </button>
                        </div>
                    </div>
                </div>
