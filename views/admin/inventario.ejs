<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Inventario' }) %>
</head>
<body class="bg-surface-container-lowest text-on-surface font-body-md text-body-md">

<%- include('../partials/admin/mobile-topbar') %>
<%- include('../partials/admin/sidebar', { activo: 'inventario', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<% const ESTADO_LABELS = { disponible: 'Disponible', bajo: 'Stock Bajo', critico: 'Stock Crítico', agotado: 'Agotado' }; %>
<% const ESTADO_BADGE = {
    disponible: 'bg-surface-container-high text-secondary',
    bajo: 'bg-secondary-container/40 text-secondary-fixed',
    critico: 'bg-error-container/40 text-error',
    agotado: 'bg-surface-container-highest text-outline'
}; %>
<% const TIPO_MOV_LABELS = { entrada: 'Entrada manual', salida: 'Salida manual', ajuste: 'Ajuste', venta: 'Venta', devolucion: 'Devolución' }; %>

<div class="pl-64">
    <main class="relative bg-surface-container-lowest min-h-screen px-8 py-8">
        <div class="flex flex-col w-full space-y-8 pb-16">
            <!-- Encabezado -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div class="space-y-2">
                    <span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-secondary flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                        MÓDULO DE CONTROL DE EXISTENCIAS &amp; TRAZABILIDAD
                    </span>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Gestión de Inventario</h1>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
                        Supervisión de existencias en tiempo real, reservas de pedidos (carritos activos) y auditoría de movimientos.
                    </p>
                </div>
            </div>

            <!-- Métricas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Disponible</span>
                        <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> <%= metricas.disponible %> refs
                        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-on-surface"><%= metricas.totalDisponible %></span>
                        <span class="font-label-sm text-label-sm text-outline">Unidades netas</span>
                    </div>
                </div>
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Stock Bajo</span>
                        <span class="px-2.5 py-1 rounded-full bg-secondary-container/40 text-secondary-fixed font-label-sm text-label-sm flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[14px]">warning</span> Atención
                        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-secondary-fixed"><%= metricas.bajo %></span>
                        <span class="font-label-sm text-label-sm text-outline">referencias</span>
                    </div>
                </div>
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Stock Crítico</span>
                        <span class="px-2.5 py-1 rounded-full bg-error-container/40 text-error font-label-sm text-label-sm flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[14px]">priority_high</span> Urgente
                        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-error"><%= metricas.critico %></span>
                        <span class="font-label-sm text-label-sm text-outline">referencias</span>
                    </div>
                </div>
                <div class="p-6 rounded-xl bg-surface-container-low flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="font-label-md text-label-md text-on-surface-variant tracking-wider uppercase">Agotado</span>
                        <span class="px-2.5 py-1 rounded-full bg-surface-container-highest text-outline font-label-sm text-label-sm flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[14px]">block</span> Alerta
                        </span>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="font-headline-md text-headline-md text-outline"><%= metricas.agotado %></span>
                        <span class="font-label-sm text-label-sm text-outline">referencias</span>
                    </div>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex items-center p-1.5 bg-surface-container-low rounded-xl w-fit">
                <button class="flex items-center gap-2.5 px-5 py-2.5 rounded-lg font-label-md text-label-md transition-all" id="tab-existencias" onclick="switchView('existencias')">
                    <span class="material-symbols-outlined text-[18px]">inventory</span>
                    <span>Listado de Existencias</span>
                    <span class="ml-1 px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm"><%= productos.length %></span>
                </button>
                <button class="flex items-center gap-2.5 px-5 py-2.5 rounded-lg font-label-md text-label-md transition-all" id="tab-movimientos" onclick="switchView('movimientos')">
                    <span class="material-symbols-outlined text-[18px]">history</span>
                    <span>Movimientos de Inventario</span>
                </button>
            </div>

            <!-- VISTA: EXISTENCIAS -->
            <div class="space-y-6 hidden" id="view-existencias">
                <form method="GET" action="/admin/inventario" class="p-5 rounded-xl bg-surface-container-low shadow-sm">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                        <div class="md:col-span-5 relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                            <input name="busqueda" value="<%= filtros.busqueda %>" class="w-full bg-surface-container rounded-lg pl-10 pr-4 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-secondary transition-all" placeholder="Buscar por producto o SKU..." type="text">
                        </div>
                        <div class="md:col-span-3">
                            <select name="estado" class="w-full bg-surface-container rounded-lg px-4 py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all cursor-pointer">
                                <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
                                <% Object.entries(ESTADO_LABELS).forEach(([valor, label]) => { %>
                                    <option value="<%= valor %>" <%= filtros.estado === valor ? 'selected' : '' %>><%= label %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <select name="categoriaId" class="w-full bg-surface-container rounded-lg px-4 py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all cursor-pointer">
                                <option value="" <%= filtros.categoriaId === '' ? 'selected' : '' %>>Colecciones</option>
                                <% categorias.forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= String(filtros.categoriaId) === String(cat.id) ? 'selected' : '' %>><%= cat.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="md:col-span-2 flex items-center justify-end gap-2">
                            <button type="submit" class="px-4 py-2.5 rounded-lg bg-secondary text-on-secondary font-label-md text-label-md font-semibold hover:bg-secondary-fixed transition-colors">Filtrar</button>
                            <a href="/admin/inventario" class="px-3 py-2.5 rounded-lg text-outline hover:text-on-surface font-label-sm text-label-sm uppercase tracking-wider transition-colors">Limpiar</a>
                        </div>
                    </div>
                </form>

                <div class="bg-surface-container-low rounded-xl shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                            <tr class="bg-surface-container font-label-sm text-label-sm uppercase tracking-widest text-outline">
                                <th class="py-4 px-6">Producto</th>
                                <th class="py-4 px-4">SKU</th>
                                <th class="py-4 px-4 text-right">Stock Físico</th>
                                <th class="py-4 px-4 text-right">Reservado</th>
                                <th class="py-4 px-4 text-right">Disponible</th>
                                <th class="py-4 px-4 text-right">Mínimo</th>
                                <th class="py-4 px-4 text-center">Estado</th>
                                <th class="py-4 px-6 text-right">Acciones</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-container-highest/20 font-body-md text-body-md">
                            <% if (productos.length === 0) { %>
                                <tr><td colspan="8" class="p-8 text-center text-on-surface-variant">No hay productos que coincidan con estos filtros.</td></tr>
                            <% } %>
                            <% productos.forEach(p => { %>
                                <tr class="hover:bg-surface-container/60 transition-colors">
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-12 rounded-lg bg-surface-container-highest overflow-hidden flex-shrink-0">
                                                <% if (p.imagen) { %><img class="w-full h-full object-cover" src="<%= p.imagen %>" alt="<%= p.nombre %>"><% } %>
                                            </div>
                                            <div class="flex flex-col">
                                                <span class="font-headline-md text-base text-on-surface font-semibold"><%= p.nombre %></span>
                                                <span class="font-label-sm text-label-sm text-outline"><%= p.categoria_nombre || '—' %><%= p.subcategoria_nombre ? ' / ' + p.subcategoria_nombre : '' %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 font-mono font-label-sm text-label-sm text-outline"><%= p.sku %></td>
                                    <td class="py-4 px-4 text-right font-medium text-on-surface"><%= p.stock %></td>
                                    <td class="py-4 px-4 text-right text-outline"><%= p.reservado %></td>
                                    <td class="py-4 px-4 text-right font-bold text-base <%= p.estadoCalculado === 'critico' || p.estadoCalculado === 'agotado' ? 'text-error' : 'text-secondary' %>"><%= p.disponible %></td>
                                    <td class="py-4 px-4 text-right text-outline"><%= p.stock_minimo %></td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full <%= ESTADO_BADGE[p.estadoCalculado] %> font-label-sm text-label-sm">
                                            <%= ESTADO_LABELS[p.estadoCalculado] %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <button class="p-1.5 rounded-lg text-outline hover:text-secondary hover:bg-surface-container-high transition-colors"
                                                onclick="openModalFor(<%= p.id %>, '<%= p.nombre.replace(/'/g, "\\'") %>', '<%= p.sku %>', <%= p.stock %>, <%= p.disponible %>)"
                                                title="Registrar Movimiento">
                                            <span class="material-symbols-outlined text-[18px]">tune</span>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VISTA: MOVIMIENTOS -->
            <div class="space-y-6" id="view-movimientos">
                <form method="GET" action="/admin/inventario" class="p-6 rounded-xl bg-surface-container-low flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <input type="hidden" name="vista" value="movimientos">
                    <div>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Auditoría de Movimientos Recientes</h2>
                        <p class="font-body-md text-body-md text-on-surface-variant">Últimos 50 registros. Historial inmutable de entradas, salidas y ajustes de stock.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-label-sm text-label-sm text-outline">Filtrar por evento:</span>
                        <select name="tipoMovimiento" onchange="this.form.submit()" class="bg-surface-container rounded-lg px-3 py-1.5 font-label-md text-label-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary">
                            <option value="" <%= filtros.tipoMovimiento === '' ? 'selected' : '' %>>Todos los movimientos</option>
                            <% Object.entries(TIPO_MOV_LABELS).forEach(([valor, label]) => { %>
                                <option value="<%= valor %>" <%= filtros.tipoMovimiento === valor ? 'selected' : '' %>><%= label %></option>
                            <% }) %>
                        </select>
                    </div>
                </form>

                <div class="bg-surface-container-low rounded-xl shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                            <tr class="bg-surface-container font-label-sm text-label-sm uppercase tracking-widest text-outline">
                                <th class="py-4 px-6">Fecha &amp; Hora</th>
                                <th class="py-4 px-4">Producto &amp; SKU</th>
                                <th class="py-4 px-4">Tipo de Movimiento</th>
                                <th class="py-4 px-4 text-center">Variación</th>
                                <th class="py-4 px-4 text-right">Anterior</th>
                                <th class="py-4 px-4 text-right">Posterior</th>
                                <th class="py-4 px-6">Motivo Declarado</th>
                                <th class="py-4 px-6">Responsable</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-container-highest/20 font-body-md text-body-md">
                            <% if (movimientos.length === 0) { %>
                                <tr><td colspan="8" class="p-8 text-center text-on-surface-variant">Aún no hay movimientos registrados.</td></tr>
                            <% } %>
                            <% movimientos.forEach(m => { %>
                                <% const variacion = m.stock_nuevo - m.stock_anterior; %>
                                <tr class="hover:bg-surface-container/60 transition-colors">
                                    <td class="py-4 px-6 font-label-sm text-label-sm text-outline whitespace-nowrap">
                                        <%= formatearFecha(m.created_at, { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                    </td>
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col">
                                            <span class="font-semibold text-on-surface"><%= m.producto_nombre %></span>
                                            <span class="font-mono font-label-sm text-label-sm text-outline"><%= m.producto_sku %></span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4">
                                        <% if (m.tipo === 'entrada') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">arrow_downward</span>
                                        <% } else if (m.tipo === 'venta') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-label-sm inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">shopping_cart</span>
                                        <% } else if (m.tipo === 'ajuste') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-error-container/40 text-error font-label-sm text-label-sm inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">tune</span>
                                        <% } else if (m.tipo === 'devolucion') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">undo</span>
                                        <% } else if (m.tipo === 'salida') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-surface-container-highest text-error font-label-sm text-label-sm inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">remove_circle_outline</span>
                                        <% } %>
                                             <%= TIPO_MOV_LABELS[m.tipo] %></span>
                                    </td>
                                    <td class="py-4 px-4 text-center font-bold <%= variacion >= 0 ? 'text-secondary' : 'text-error' %>"><%= variacion >= 0 ? '+' : '' %><%= variacion %></td>
                                    <td class="py-4 px-4 text-right text-outline"><%= m.stock_anterior %></td>
                                    <td class="py-4 px-4 text-right font-medium text-on-surface"><%= m.stock_nuevo %></td>
                                    <td class="py-4 px-6 text-on-surface-variant font-label-md text-label-md"><%= m.motivo %></td>
                                    <td class="py-4 px-6 whitespace-nowrap">
                                        <span class="font-medium text-on-surface text-sm"><%= m.actor || 'Sistema' %></span>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal: Registrar Movimiento -->
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-opacity hidden" id="modal-stock">
                <div class="bg-surface-container-low rounded-2xl max-w-lg w-full p-8 shadow-2xl space-y-6 relative">
                    <button class="absolute top-6 right-6 p-2 rounded-full text-outline hover:text-on-surface hover:bg-surface-container-high transition-colors" onclick="closeModal()">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">Acción Directa de Bodega</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface">Registrar Movimiento</h3>
                        <p class="font-label-md text-label-md text-outline" id="modal-product-subtitle"></p>
                    </div>

                    <form id="form-movimiento" method="POST" action="/admin/inventario/movimiento" class="space-y-6">
                        <input type="hidden" name="productoId" id="input-producto-id">

                        <div class="space-y-2">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Tipo de Movimiento</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button" class="btn-mov py-2.5 px-3 rounded-lg font-label-md text-label-md flex items-center justify-center gap-1.5 transition-colors" id="btn-mov-entrada" onclick="setMovementType('entrada')">
                                    <span class="material-symbols-outlined text-[18px]">add</span> Entrada (+)
                                </button>
                                <button type="button" class="btn-mov py-2.5 px-3 rounded-lg font-label-md text-label-md flex items-center justify-center gap-1.5 transition-colors" id="btn-mov-salida" onclick="setMovementType('salida')">
                                    <span class="material-symbols-outlined text-[18px]">remove</span> Salida (-)
                                </button>
                                <button type="button" class="btn-mov py-2.5 px-3 rounded-lg font-label-md text-label-md flex items-center justify-center gap-1.5 transition-colors" id="btn-mov-ajuste" onclick="setMovementType('ajuste')">
                                    <span class="material-symbols-outlined text-[18px]">tune</span> Ajuste (=)
                                </button>
                            </div>
                            <input type="hidden" name="tipo" id="input-tipo" value="entrada">
                        </div>

                        <div class="space-y-2">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-outline" for="input-qty" id="label-qty">Cantidad de Unidades</label>
                            <input class="w-full bg-surface-container rounded-lg px-4 py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="input-qty" name="cantidad" min="0" oninput="updateCalculation()" type="number" required>
                        </div>

                        <div class="space-y-2">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-outline flex items-center justify-between" for="input-reason">
                                <span>Motivo del Movimiento (Obligatorio)</span>
                                <span class="text-secondary font-label-sm text-label-sm">Auditoría Requerida</span>
                            </label>
                            <textarea class="w-full bg-surface-container rounded-lg px-4 py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="input-reason" name="motivo" placeholder="Ej. Recepción de lote, rotura de inventario o muestra promocional..." rows="2" required></textarea>
                        </div>

                        <div class="p-4 rounded-xl bg-surface-container flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="font-label-sm text-label-sm text-outline">Stock Físico Actual</span>
                                <span class="font-headline-md text-lg text-on-surface font-semibold" id="calc-current">0 uds</span>
                            </div>
                            <span class="material-symbols-outlined text-outline">arrow_forward</span>
                            <div class="flex flex-col text-right">
                                <span class="font-label-sm text-label-sm text-secondary">Stock Proyectado</span>
                                <span class="font-headline-md text-lg text-secondary font-bold" id="calc-projected">0 uds</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-2">
                            <button class="px-5 py-2.5 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright font-label-md text-label-md transition-colors" onclick="closeModal()" type="button">Cancelar</button>
                            <button class="px-6 py-2.5 rounded-lg bg-secondary text-on-secondary font-label-md text-label-md font-bold hover:bg-secondary-fixed transition-colors shadow-md" type="submit">
                                Confirmar y Guardar en Historial
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    window.__vistaInicial = <%- JSON.stringify(filtros.tipoMovimiento || (typeof filtros !== 'undefined' ? '' : '')) %>;
</script>
<script src="/javascripts/admin/sidebar-toggle.js"></script>
<script src="/javascripts/admin/inventario.js"></script>
</body>
</html>