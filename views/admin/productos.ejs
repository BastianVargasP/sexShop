<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Productos' }) %>
</head>
<body class="bg-background text-on-surface font-body-md h-screen overflow-hidden flex">

<%- include('../partials/admin/mobile-topbar') %>
<%- include('../partials/admin/sidebar', { activo: 'productos', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<main class="ml-64 p-gutter w-full h-[calc(100vh-64px)] overflow-y-auto bg-background">
    <div class="flex justify-between items-end mb-8">
        <div>
            <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">Inventario</p>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Gestión de Catálogo</h2>
        </div>
        <% if (categorias.length === 0) { %>
            <a href="/admin/categorias" class="bg-secondary text-on-secondary px-6 py-3 rounded font-label-md text-label-md font-bold hover:shadow-[0_0_15px_rgba(212,175,55,0.3)] transition-all flex items-center gap-2">
                <span class="material-symbols-outlined">category</span>
                Crea una categoría primero
            </a>
        <% } else { %>
            <button class="bg-secondary text-on-secondary px-6 py-3 rounded font-label-md text-label-md font-bold hover:shadow-[0_0_15px_rgba(212,175,55,0.3)] transition-all flex items-center gap-2"
                    onclick="abrirDrawerNuevo()">
                <span class="material-symbols-outlined">add</span>
                Crear Producto
            </button>
        <% } %>
    </div>

    <!-- Filtros -->
    <form method="GET" action="/admin/productos" class="glass-panel p-6 rounded-xl mb-8">
        <div class="flex items-center gap-2 mb-4 text-secondary">
            <span class="material-symbols-outlined">filter_list</span>
            <span class="font-label-md text-label-md uppercase tracking-wider">Filtros</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2">Categoría</label>
                <select name="categoriaId" class="w-full bg-surface-container-highest border border-secondary/20 rounded p-2 text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary appearance-none">
                    <option value="" <%= filtros.categoriaId === '' ? 'selected' : '' %>>Todas las categorías</option>
                    <% categorias.forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= String(filtros.categoriaId) === String(cat.id) ? 'selected' : '' %>><%= cat.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2">Estado</label>
                <select name="estado" class="w-full bg-surface-container-highest border border-secondary/20 rounded p-2 text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary appearance-none">
                    <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
                    <option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activo</option>
                    <option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2">Buscar por nombre o SKU</label>
                <input type="text" name="busqueda" value="<%= filtros.busqueda %>" placeholder="Ej: Élixir Sensuel / LX-EST-..."
                       class="w-full bg-surface-container-highest border border-secondary/20 rounded p-2 text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary">
            </div>
        </div>
        <div class="flex justify-end gap-3 mt-4">
            <a href="/admin/productos" class="px-4 py-2 rounded text-on-surface-variant hover:text-on-surface transition-colors font-label-sm text-label-sm">Limpiar</a>
            <button type="submit" class="bg-secondary text-on-secondary px-6 py-2 rounded font-label-md text-label-md font-bold">Filtrar</button>
        </div>
    </form>

    <!-- Tabla -->
    <div class="bg-surface-container-low rounded-xl border border-secondary/10 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="border-b border-secondary/10 bg-surface-container-high/50">
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium">Producto</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium">SKU</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium">Categoría / Marca</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium text-right">Precio</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium text-center">Stock</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium text-center">Estado</th>
                    <th class="p-4 font-label-sm text-label-sm text-on-surface-variant font-medium text-right">Acciones</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high">
                <% if (productos.length === 0) { %>
                    <tr>
                        <td colspan="7" class="p-8 text-center text-on-surface-variant">No hay productos que coincidan con estos filtros.</td>
                    </tr>
                <% } %>
                <% productos.forEach(producto => { %>
                    <tr class="hover:bg-surface-container-high/30 transition-colors group <%= !producto.activo ? 'opacity-60' : '' %>">
                        <td class="p-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded bg-surface-container-highest border border-secondary/20 overflow-hidden shrink-0">
                                    <% if (producto.imagen) { %>
                                        <img class="w-full h-full object-cover" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                                    <% } %>
                                </div>
                                <div>
                                    <p class="font-body-md text-body-md text-on-surface font-medium group-hover:text-secondary transition-colors"><%= producto.nombre %></p>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 text-[11px]">Añadido: <%= producto.created_at.toLocaleDateString("es-CL", {day:"numeric", month:"short", year:"numeric"}) %></p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 font-mono font-label-sm text-label-sm text-on-surface-variant text-[11px]"><%= producto.sku %></td>
                        <td class="p-4">
                            <p class="font-body-md text-body-md text-on-surface text-sm">
                                <%= producto.categoria_nombre || '—' %><% if (producto.subcategoria_nombre) { %> / <%= producto.subcategoria_nombre %><% } %>
                            </p>
                            <% if (producto.marca) { %>
                                <p class="font-label-sm text-label-sm text-primary mt-1"><%= producto.marca %></p>
                            <% } %>
                        </td>
                        <td class="p-4 text-right">
                            <p class="font-body-md text-body-md text-secondary font-medium"><%= formatearCLP(producto.precio) %></p>
                        </td>
                        <td class="p-4 text-center">
                            <span class="inline-block px-2 py-1 rounded <%= producto.stock === 0 ? 'bg-error-container/10 border border-error/30 text-error' : 'bg-surface-container-highest border border-outline-variant text-on-surface' %> text-xs font-medium">
                                <%= producto.stock %>
                            </span>
                        </td>
                        <td class="p-4 text-center">
                            <% if (producto.activo) { %>
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-secondary-container/20 border border-secondary/30 text-secondary text-[11px] font-bold uppercase tracking-wider">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Activo
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-surface-container-highest border border-outline-variant text-on-surface-variant text-[11px] font-bold uppercase tracking-wider">
                                    <span class="w-1.5 h-1.5 rounded-full bg-outline"></span> Inactivo
                                </span>
                            <% } %>
                        </td>
                        <td class="p-4">
                            <div class="flex items-center justify-end gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
                                <a href="/admin/productos/<%= producto.id %>/editar" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-surface-variant text-on-surface-variant hover:text-secondary" title="Editar">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </a>
                                <form method="POST" action="/admin/productos/<%= producto.id %>/activar" class="contents">
                                    <button type="submit" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-surface-variant text-on-surface-variant hover:text-secondary"
                                            title="<%= producto.activo ? 'Desactivar' : 'Activar' %>">
                                        <span class="material-symbols-outlined text-[18px]"><%= producto.activo ? 'visibility_off' : 'visibility' %></span>
                                    </button>
                                </form>
                                <form method="POST" action="/admin/productos/<%= producto.id %>/eliminar" class="contents" onsubmit="return confirm('¿Eliminar este producto? Esta acción no se puede deshacer.');">
                                    <button type="submit" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-error-container/20 text-on-surface-variant hover:text-error" title="Eliminar">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="h-24"></div>
</main>

<!-- Drawer Overlay -->
<div class="fixed inset-0 bg-background/80 backdrop-blur-sm z-[60] transition-opacity duration-300 opacity-0 hidden"
     id="drawerOverlay" onclick="toggleProductDrawer()"></div>

<!-- Drawer: Crear / Editar -->
<aside class="fixed top-0 right-0 w-full md:w-[600px] h-screen bg-surface-container-low border-l border-secondary/20 z-[70] shadow-2xl transform transition-transform duration-300 ease-in-out flex flex-col <%= productoEditando ? '' : 'translate-x-full' %>"
       id="productDrawer">
    <div class="h-16 px-6 flex items-center justify-between border-b border-secondary/10 bg-surface/90 backdrop-blur-md shrink-0">
        <h3 class="font-headline-md text-headline-md text-secondary text-xl">
            <%= productoEditando ? 'Editar Producto' : 'Nuevo Producto' %>
        </h3>
        <% if (productoEditando) { %>
            <a href="/admin/productos" class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:text-secondary hover:bg-surface-variant transition-colors">
                <span class="material-symbols-outlined">close</span>
            </a>
        <% } else { %>
            <button class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:text-secondary hover:bg-surface-variant transition-colors"
                    onclick="toggleProductDrawer()">
                <span class="material-symbols-outlined">close</span>
            </button>
        <% } %>
    </div>

    <form class="flex-1 overflow-y-auto p-6 space-y-6 custom-scrollbar" method="POST"
          action="<%= productoEditando ? '/admin/productos/' + productoEditando.id + '/editar' : '/admin/productos' %>">

        <% if (productoEditando) { %>
            <div class="bg-surface-container-high/50 border border-secondary/10 rounded-lg p-3 flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">SKU (no editable)</span>
                <span class="font-mono text-secondary text-sm"><%= productoEditando.sku %></span>
            </div>
        <% } else { %>
            <div class="bg-surface-container-high/50 border border-secondary/10 rounded-lg p-3 text-on-surface-variant text-xs">
                El SKU se genera automáticamente al guardar, según la categoría elegida.
            </div>
        <% } %>

        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Nombre del Producto *</label>
            <input class="input-premium w-full p-3 rounded-t" name="nombre" required type="text"
                   value="<%= productoEditando ? productoEditando.nombre : '' %>" placeholder="Ej: Aceite de Masaje Sensual">
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Descripción *</label>
            <textarea class="input-premium w-full p-3 rounded-t min-h-[120px]" name="descripcion" required
                      placeholder="Descripción para la página detallada del producto"><%= productoEditando ? productoEditando.descripcion : '' %></textarea>
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Descripción Corta</label>
            <textarea class="input-premium w-full p-3 rounded-t min-h-[80px]" name="descripcionCorta"
                      placeholder="Breve descripción para listados..."><%= productoEditando ? (productoEditando.descripcion_corta || '') : '' %></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Categoría *</label>
                <select class="input-premium w-full p-3 rounded-t appearance-none" name="categoriaId" id="selectCategoria" required <%= categorias.length === 0 ? 'disabled' : '' %>>
                    <option value="">Seleccionar categoría</option>
                    <% categorias.forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= (productoEditando && String(productoEditando.categoria_id) === String(cat.id)) ? 'selected' : '' %>>
                            <%= cat.nombre %><%= !cat.activa ? ' (inactiva)' : '' %>
                        </option>
                    <% }) %>
                </select>
                <% if (categorias.length === 0) { %>
                    <span class="text-[10px] text-error mt-1 block">No hay categorías creadas. <a href="/admin/categorias" class="underline">Crea una primero</a>.</span>
                <% } %>
            </div>
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Subcategoría</label>
                <select class="input-premium w-full p-3 rounded-t appearance-none" name="subcategoriaId" id="selectSubcategoria">
                    <option value="">Sin subcategoría</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Marca</label>
                <input class="input-premium w-full p-3 rounded-t" name="marca" type="text" placeholder="Ej: Lelo"
                       value="<%= productoEditando ? (productoEditando.marca || '') : '' %>">
            </div>
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Precio (CLP) *</label>
                <input class="input-premium w-full p-3 rounded-t" name="precio" type="number" min="0" step="1" required
                       value="<%= productoEditando ? productoEditando.precio : '' %>">
            </div>
        </div>

        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Stock</label>
            <input class="input-premium w-full p-3 rounded-t" name="stock" type="number" min="0" step="1"
                   value="<%= productoEditando ? productoEditando.stock : 0 %>">
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">URL de Imagen</label>
            <input class="input-premium w-full p-3 rounded-t" name="imagen" type="text" placeholder="https://..."
                   value="<%= productoEditando ? (productoEditando.imagen || '') : '' %>">
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Etiqueta (opcional)</label>
            <input class="input-premium w-full p-3 rounded-t" name="etiqueta" type="text" placeholder="Ej: Nuevo, Oferta"
                   value="<%= productoEditando ? (productoEditando.etiqueta || '') : '' %>">
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Características (una por línea)</label>
            <textarea class="input-premium w-full p-3 rounded-t min-h-[100px]" name="caracteristicas"
                      placeholder="Hipoalergénico&#10;Resistente al agua"><%= productoEditando && productoEditando.caracteristicas ? productoEditando.caracteristicas.join('\n') : '' %></textarea>
        </div>
        <label class="flex items-center gap-3 cursor-pointer">
            <input class="checkbox-premium" type="checkbox" name="destacado" value="true"
                    <%= (productoEditando && productoEditando.destacado) ? 'checked' : '' %>>
            <span class="font-body-md text-body-md text-on-surface">Producto destacado</span>
        </label>

        <div class="pt-4 flex gap-4">
            <% if (productoEditando) { %>
                <a href="/admin/productos" class="flex-1 py-3 px-4 border border-outline-variant text-on-surface rounded font-label-md text-label-md hover:bg-surface-container-high transition-colors text-center">Cancelar</a>
            <% } else { %>
                <button type="button" onclick="toggleProductDrawer()" class="flex-1 py-3 px-4 border border-outline-variant text-on-surface rounded font-label-md text-label-md hover:bg-surface-container-high transition-colors text-center">Cancelar</button>
            <% } %>
            <button type="submit" class="flex-1 py-3 px-4 bg-secondary text-on-secondary rounded font-label-md text-label-md font-bold hover:bg-secondary-fixed transition-colors text-center shadow-[0_0_10px_rgba(212,175,55,0.2)]">
                <%= productoEditando ? 'Guardar Cambios' : 'Guardar Producto' %>
            </button>
        </div>
    </form>
</aside>

<!-- Datos para el select dependiente de subcategoría -->
<script>
    window.__subcategorias = <%- JSON.stringify(subcategorias.map(s => ({ id: s.id, nombre: s.nombre, categoriaId: s.categoria_id, activa: s.activa }))) %>;
    window.__subcategoriaSeleccionada = <%- JSON.stringify(productoEditando ? productoEditando.subcategoria_id : null) %>;
</script>

<script src="/javascripts/admin/sidebar-toggle.js"></script>
<script src="/javascripts/admin/productos-admin.js"></script>
</body>
</html>