<script>
    // Simple mobile menu toggle
    const openNav = document.getElementById('open-nav');
    const closeNav = document.getElementById('close-nav');
    const sideNav = document.getElementById('sidenav');
    const navOverlay = document.getElementById('nav-overlay');

    function toggleNav() {
        const isClosed = sideNav.classList.contains('-translate-x-full');
        if (isClosed) {
            sideNav.classList.remove('-translate-x-full');
            navOverlay.classList.remove('hidden');
            setTimeout(() => navOverlay.classList.add('opacity-100'), 10);
        } else {
            sideNav.classList.add('-translate-x-full');
            navOverlay.classList.remove('opacity-100');
            setTimeout(() => navOverlay.classList.add('hidden'), 300);
        }
    }

    openNav.addEventListener('click', toggleNav);
    closeNav.addEventListener('click', toggleNav);
    navOverlay.addEventListener('click', toggleNav);
</script>




