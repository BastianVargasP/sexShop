<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Gestión de Pedidos' }) %>
</head>
<body class="bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex selection:bg-secondary/30 selection:text-secondary">

<%- include('../partials/admin/mobile-topbar') %>
<%- include('../partials/admin/sidebar', { activo: 'pedidos', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<% const ESTADO_LABELS = { procesando: 'Procesando', enviado: 'Enviado', entregado: 'Entregado', devuelto: 'Devuelto', cancelado: 'Cancelado' }; %>
<% const PAGO_LABELS = { pendiente: 'Pendiente', pagado: 'Pagado', rechazado: 'Rechazado', reembolsado: 'Reembolsado' }; %>

<main class="flex-1 md:ml-64 min-h-screen flex flex-col relative overflow-hidden bg-background">
    <div class="flex-1 p-margin-mobile md:p-margin-desktop overflow-y-auto z-10 relative">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10">
            <div>
                <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-semibold">Pedidos</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2"><%= total %> pedido<%= total !== 1 ? 's' : '' %> en el sistema.</p>
            </div>
        </div>

        <!-- Filtros -->
        <form method="GET" action="/admin/pedidos" class="border border-secondary/10 rounded-xl p-6 mb-10 shadow-lg relative overflow-hidden bg-surface-container">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 relative z-10">
                <div class="space-y-2">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block">Desde</label>
                    <input type="date" name="desde" value="<%= filtros.desde %>"
                           class="w-full bg-surface-container-low border-b border-secondary/30 focus:border-secondary border-t-0 border-l-0 border-r-0 text-on-surface py-2 focus:ring-0 transition-colors text-sm">
                </div>
                <div class="space-y-2">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block">Hasta</label>
                    <input type="date" name="hasta" value="<%= filtros.hasta %>"
                           class="w-full bg-surface-container-low border-b border-secondary/30 focus:border-secondary border-t-0 border-l-0 border-r-0 text-on-surface py-2 focus:ring-0 transition-colors text-sm">
                </div>
                <div class="space-y-2">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block">Estado Pago</label>
                    <select name="estadoPago" class="w-full bg-surface-container-low border-b border-secondary/30 focus:border-secondary border-t-0 border-l-0 border-r-0 text-on-surface py-2 focus:ring-0 transition-colors appearance-none text-sm">
                        <option value="" <%= filtros.estadoPago === '' ? 'selected' : '' %>>Todos los pagos</option>
                        <% Object.entries(PAGO_LABELS).forEach(([valor, label]) => { %>
                            <option value="<%= valor %>" <%= filtros.estadoPago === valor ? 'selected' : '' %>><%= label %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block">Estado Pedido</label>
                    <select name="estado" class="w-full bg-surface-container-low border-b border-secondary/30 focus:border-secondary border-t-0 border-l-0 border-r-0 text-on-surface py-2 focus:ring-0 transition-colors appearance-none text-sm">
                        <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
                        <% Object.entries(ESTADO_LABELS).forEach(([valor, label]) => { %>
                            <option value="<%= valor %>" <%= filtros.estado === valor ? 'selected' : '' %>><%= label %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block">Buscar</label>
                    <input type="text" name="busqueda" value="<%= filtros.busqueda %>" placeholder="N° pedido, nombre o email"
                           class="w-full bg-surface-container-low border-b border-secondary/30 focus:border-secondary border-t-0 border-l-0 border-r-0 text-on-surface py-2 focus:ring-0 transition-colors text-sm">
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6 relative z-10">
                <a href="/admin/pedidos" class="text-on-surface-variant hover:text-secondary text-sm flex items-center gap-1 transition-colors px-2">
                    <span class="material-symbols-outlined text-[16px]">close</span> Limpiar
                </a>
                <button type="submit" class="bg-secondary text-on-secondary px-6 py-2 rounded font-label-md text-label-md font-bold">Filtrar</button>
            </div>
        </form>

        <!-- Tabla de pedidos -->
        <div class="bg-surface-container-low rounded-xl border border-secondary/10 overflow-hidden shadow-2xl relative">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                    <tr class="bg-surface-container-highest/50 border-b border-secondary/10">
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap">ID Pedido</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap">Fecha</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap">Cliente</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap">Total</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap max-w-[140px]">Estado Pago</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap max-w-[140px]">Estado Pedido</th>
                        <th class="py-4 px-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest whitespace-nowrap text-right">Acciones</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-secondary/5 font-body-md text-sm">
                    <% if (pedidos.length === 0) { %>
                        <tr><td colspan="7" class="p-8 text-center text-on-surface-variant">No hay pedidos que coincidan con estos filtros.</td></tr>
                    <% } %>
                    <% pedidos.forEach(pedido => { %>
                        <tr class="hover:bg-secondary/5 transition-colors group relative">
                            <td class="py-4 px-6 font-medium text-secondary">#<%= pedido.numero_pedido %></td>
                            <td class="py-4 px-6 text-on-surface-variant">
                                <%= formatearFecha(pedido.created_at, { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </td>
                            <td class="py-4 px-6 text-on-surface"><%= pedido.cliente_nombre %> <%= pedido.cliente_apellido %></td>
                            <td class="py-4 px-6 text-on-surface font-semibold"><%= formatearCLP(pedido.total) %></td>
                            <td class="py-4 px-6">
                                <select data-pedido-id="<%= pedido.id %>" data-tipo="pago" class="selector-estado w-[130px]">
                                    <% Object.entries(PAGO_LABELS).forEach(([valor, label]) => { %>
                                        <option value="<%= valor %>" <%= pedido.estado_pago === valor ? 'selected' : '' %>><%= label %></option>
                                    <% }) %>
                                </select>
                            </td>
                            <td class="py-4 px-6">
                                <select data-pedido-id="<%= pedido.id %>" data-tipo="estado" class="selector-estado w-[130px]">
                                    <% Object.entries(ESTADO_LABELS).forEach(([valor, label]) => { %>
                                        <option value="<%= valor %>" <%= pedido.estado === valor ? 'selected' : '' %>><%= label %></option>
                                    <% }) %>
                                </select>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-3 transition-opacity">
                                    <button class="text-on-surface-variant hover:text-secondary transition-colors" title="Ver Detalle" data-abrir-detalle-pedido="<%= pedido.id %>">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="bg-surface-container-low border-t border-secondary/10 px-6 py-4 flex items-center justify-between">
                <p class="text-sm text-on-surface-variant">Página <span class="font-medium text-on-surface"><%= paginaActual %></span> de <span class="font-medium text-on-surface"><%= totalPaginas %></span> — <%= total %> resultados</p>
                <div class="flex items-center gap-2">
                    <% const qs = (p) => { const params = new URLSearchParams({ ...filtros, pagina: p }); Object.keys(filtros).forEach(k => { if (!filtros[k]) params.delete(k); }); return params.toString(); }; %>
                    <a href="/admin/pedidos?<%= qs(Math.max(1, paginaActual - 1)) %>"
                       class="p-1 rounded-md text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-colors <%= paginaActual <= 1 ? 'opacity-40 pointer-events-none' : '' %>">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                    <a href="/admin/pedidos?<%= qs(Math.min(totalPaginas, paginaActual + 1)) %>"
                       class="p-1 rounded-md text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-colors <%= paginaActual >= totalPaginas ? 'opacity-40 pointer-events-none' : '' %>">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Panel de detalle de pedido -->
<div class="fixed inset-0 z-50 flex justify-end hidden" id="order-modal">
    <div class="absolute inset-0 bg-background/80" data-cerrar-detalle-pedido></div>
    <div class="relative w-full max-w-2xl bg-surface-container h-full shadow-2xl border-l border-secondary/20 flex flex-col transform transition-transform duration-300 translate-x-0">
        <div class="flex items-center justify-between px-8 py-6 border-b border-secondary/10 bg-surface/50 backdrop-blur-xl">
            <div>
                <h3 id="modal-numero-pedido" class="font-headline-md text-headline-md text-on-surface font-semibold flex items-center gap-3"></h3>
                <p id="modal-fecha-pedido" class="font-body-sm text-sm text-on-surface-variant mt-1"></p>
            </div>
            <button class="text-on-surface-variant hover:text-secondary transition-colors bg-surface-container-highest p-2 rounded-full h-min" data-cerrar-detalle-pedido>
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto p-8 space-y-10 custom-scrollbar">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-4">
                    <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">person</span> Datos del Cliente
                    </h4>
                    <div class="bg-surface-container-low p-4 rounded-lg border border-secondary/5">
                        <p id="modal-cliente-nombre" class="text-on-surface font-medium"></p>
                        <p id="modal-cliente-email" class="text-on-surface-variant text-sm mt-1"></p>
                        <p id="modal-cliente-telefono" class="text-on-surface-variant text-sm mt-1"></p>
                    </div>
                </div>
                <div class="space-y-4">
                    <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">local_shipping</span> Dirección de Entrega
                    </h4>
                    <div id="modal-direccion" class="bg-surface-container-low p-4 rounded-lg border border-secondary/5 text-on-surface-variant text-sm"></div>
                </div>
            </div>

            <div class="space-y-4">
                <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">shopping_bag</span> Productos Comprados
                </h4>
                <div class="bg-surface-container-low rounded-lg border border-secondary/5 overflow-hidden">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-container-highest/30 border-b border-secondary/10">
                        <tr>
                            <th class="px-4 py-3 font-label-sm text-on-surface-variant uppercase">Producto</th>
                            <th class="px-4 py-3 font-label-sm text-on-surface-variant uppercase text-center">Cant.</th>
                            <th class="px-4 py-3 font-label-sm text-on-surface-variant uppercase text-right">Precio</th>
                        </tr>
                        </thead>
                        <tbody id="modal-items" class="divide-y divide-secondary/5"></tbody>
                    </table>
                </div>
            </div>

            <div class="space-y-4">
                <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">payments</span> Método de Pago
                </h4>
                <div id="modal-metodo-pago" class="bg-surface-container-low p-4 rounded-lg border border-secondary/5 text-sm text-on-surface"></div>
            </div>

            <div class="space-y-4">
                <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">receipt</span> Resumen Financiero
                </h4>
                <div id="modal-resumen" class="bg-surface-container-low p-4 rounded-lg border border-secondary/5 space-y-2"></div>
            </div>

            <div class="space-y-4">
                <h4 class="font-label-md text-label-md uppercase tracking-widest text-secondary flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">history</span> Historial de Estados
                </h4>
                <div id="modal-historial" class="space-y-4 relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[1px] before:bg-secondary/20"></div>
            </div>
        </div>
    </div>
</div>

<!-- Datos embebidos para poblar el modal sin ida y vuelta al servidor -->
<script>
    window.__pedidos = <%- JSON.stringify(pedidos) %>;
    window.__ESTADO_LABELS = <%- JSON.stringify(ESTADO_LABELS) %>;
    window.__PAGO_LABELS = <%- JSON.stringify(PAGO_LABELS) %>;
    window.__usuarioActual = <%- JSON.stringify(usuario ? `${usuario.nombre} ${usuario.apellido}` : 'Admin') %>;
</script>

<script src="/javascripts/admin/sidebar-toggle.js"></script>
<script src="/javascripts/admin/pedidos.js"></script>
</body>
</html>