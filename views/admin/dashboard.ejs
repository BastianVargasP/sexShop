<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Dashboard' }) %>
</head>
<body class="bg-background text-on-surface font-body-md antialiased overflow-x-hidden selection:bg-secondary selection:text-on-secondary">

<%- include('../partials/admin/mobile-topbar') %>

<div class="flex h-screen overflow-hidden">
    <%- include('../partials/admin/sidebar', { activo: 'dashboard', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto md:ml-64 bg-background">
        <header class="hidden md:flex items-center justify-between px-margin-desktop py-6 sticky top-0 z-30 bg-background/90 backdrop-blur-md border-b border-surface-container-highest">
            <div class="flex items-center gap-4">
                <h1 class="font-headline-md text-headline-md text-on-surface">General</h1>
            </div>
        </header>
        <div class="p-margin-mobile md:p-margin-desktop max-w-container-max mx-auto w-full flex flex-col gap-gutter">

            <!-- Alertas -->
            <div class="flex flex-col mb-8">
                <div class="flex items-center justify-between mb-6 border-b border-surface-container-highest pb-3">
                    <h2 class="font-headline-md text-[28px] text-on-surface mb-0">Alertas</h2>
                    <div class="flex gap-3">
                        <div class="flex items-center gap-2 bg-error-container/20 text-error px-3 py-1.5 rounded text-label-sm font-label-sm border border-error/20">
                            <span class="material-symbols-outlined text-[16px]">warning</span> Stock crítico
                        </div>
                        <div class="flex items-center gap-2 bg-secondary-container/20 text-secondary px-3 py-1.5 rounded text-label-sm font-label-sm border border-secondary/20">
                            <span class="material-symbols-outlined text-[16px]">schedule</span> Pedidos pendientes
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-error">
                        <div>
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Stock crítico</h3>
                            <div class="font-headline-lg text-headline-lg text-error">5</div>
                        </div>
                        <span class="material-symbols-outlined text-error text-[32px]">warning</span>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-secondary">
                        <div>
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Pagos pendientes</h3>
                            <div class="font-headline-lg text-headline-lg text-secondary">8</div>
                        </div>
                        <span class="material-symbols-outlined text-secondary text-[32px]">schedule</span>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-secondary">
                        <div>
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Pedidos sin procesar</h3>
                            <div class="font-headline-lg text-headline-lg text-on-surface">12</div>
                        </div>
                        <span class="material-symbols-outlined text-on-surface-variant text-[32px]">package_2</span>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-error">
                        <div>
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Productos agotados</h3>
                            <div class="font-headline-lg text-headline-lg text-error">3</div>
                        </div>
                        <span class="material-symbols-outlined text-error text-[32px]">cancel</span>
                    </div>
                </div>
            </div>

            <!-- Métricas -->
            <div class="flex flex-col mb-8">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-surface-container-highest pb-3">
                    <h2 class="font-headline-md text-[28px] text-on-surface mb-0 pb-0 border-b-0">Métricas</h2>
                    <div class="flex flex-wrap items-center gap-2">
                        <button class="px-4 py-2 rounded-full border border-secondary text-secondary font-label-md text-label-sm bg-secondary/10">Hoy</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors">Últimos 7 días</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors">Último mes</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors flex items-center gap-2">Rango personalizado <span class="material-symbols-outlined text-[16px]">calendar_today</span></button>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 md:grid-cols-1 flex flex-col lg:grid">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:col-span-4 md:grid-cols-1">
                        <div class="glass-panel rounded-xl flex flex-col justify-between glow-hover transition-all relative overflow-hidden group px-6 py-4">
                            <div class="absolute -right-10 -top-10 w-40 h-40 bg-secondary/5 rounded-full blur-2xl group-hover:bg-secondary/10 transition-all"></div>
                            <div class="relative z-10 flex flex-col h-full">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Ventas Totales</h3>
                                    <span class="material-symbols-outlined text-secondary">monitoring</span>
                                </div>
                                <div class="flex-1 flex flex-col justify-center">
                                    <div class="font-headline-xl text-headline-xl text-on-surface">$125.430</div>
                                    <div class="flex items-center gap-2 mt-2 text-secondary text-label-sm">
                                        <span class="material-symbols-outlined text-[16px]">trending_up</span><span>+12.5% vs mes anterior</span>
                                    </div>
                                </div>
                                <div class="mt-auto pt-8 border-t border-white/5 flex flex-col lg:grid lg:grid-cols-3 gap-4">
                                    <div class="flex justify-between lg:block text-center border-b border-white/5 lg:border-b-0 pb-2 lg:pb-0 items-center">
                                        <div class="text-label-sm text-on-surface-variant mb-1">Hoy</div>
                                        <div class="font-headline-md text-headline-md text-on-surface">$1.200</div>
                                    </div>
                                    <div class="flex justify-between lg:block text-center border-b border-white/5 lg:border-b-0 lg:border-x lg:border-white/5 py-2 lg:py-0 items-center">
                                        <div class="text-label-sm text-on-surface-variant mb-1">Esta Semana</div>
                                        <div class="font-headline-md text-headline-md text-on-surface">$8.500</div>
                                    </div>
                                    <div class="flex justify-between lg:block text-center pt-2 lg:pt-0 items-center">
                                        <div class="text-label-sm text-on-surface-variant mb-1">Este Mes</div>
                                        <div class="font-headline-md text-headline-md text-secondary">$32.000</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="glass-panel rounded-xl flex flex-col gap-4 glow-hover transition-all px-6 py-4">
                            <div class="flex justify-between items-center w-full">
                                <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Estado de Stock</h3>
                                <span class="material-symbols-outlined text-secondary">inventory_2</span>
                            </div>
                            <div class="pt-4 border-t border-surface-container-highest flex flex-col gap-4 w-full">
                                <div class="flex justify-between items-center w-full">
                                    <div class="text-label-md text-on-surface-variant uppercase tracking-widest">Bajo</div>
                                    <div class="text-error font-headline-lg text-headline-lg">12</div>
                                </div>
                                <div class="flex justify-between items-center w-full">
                                    <div class="text-label-md text-on-surface-variant uppercase tracking-widest">Agotados</div>
                                    <div class="text-error font-headline-lg text-headline-lg">3</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:col-span-4 md:grid-cols-1">
                        <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all">
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Cantidad de pedidos</h3>
                            <div class="font-headline-lg text-headline-lg text-on-surface">1,240</div>
                        </div>
                        <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all">
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Clientes registrados</h3>
                            <div class="font-headline-lg text-headline-lg text-on-surface">8,920</div>
                        </div>
                        <div class="glass-panel p-6 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-secondary">
                            <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Pedidos pendientes</h3>
                            <div class="font-headline-lg text-headline-lg text-secondary">45</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actividad Reciente -->
            <div class="flex flex-col mb-8">
                <div class="flex items-center justify-between mb-6 border-b border-surface-container-highest pb-3">
                    <h2 class="font-headline-md text-[28px] text-on-surface mb-0">Actividad Reciente</h2>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-6">
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all">
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4 border-b border-surface-container-highest pb-2">Últimos pedidos</h3>
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10245</div>
                                    <div class="text-label-sm text-on-surface-variant">30/10/2023</div>
                                </div>
                                <span class="text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded">Completado</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10244</div>
                                    <div class="text-label-sm text-on-surface-variant">30/10/2023</div>
                                </div>
                                <span class="text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded">Pendiente</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10243</div>
                                    <div class="text-label-sm text-on-surface-variant">29/10/2023</div>
                                </div>
                                <span class="text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded">Enviado</span>
                            </div>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all">
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4 border-b border-surface-container-highest pb-2">Últimos usuarios registrados</h3>
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">Sofía Martínez</div>
                                    <div class="text-label-sm text-on-surface-variant">Hace 2 horas</div>
                                </div>
                                <span class="material-symbols-outlined text-on-surface-variant">person_add</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">Carlos G.</div>
                                    <div class="text-label-sm text-on-surface-variant">Hace 5 horas</div>
                                </div>
                                <span class="material-symbols-outlined text-on-surface-variant">person_add</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">Elena R.</div>
                                    <div class="text-label-sm text-on-surface-variant">Ayer</div>
                                </div>
                                <span class="material-symbols-outlined text-on-surface-variant">person_add</span>
                            </div>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all">
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4 border-b border-surface-container-highest pb-2">Pagos recientes</h3>
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">$145.000 CLP</div>
                                    <div class="text-label-sm text-on-surface-variant">Tarjeta de crédito</div>
                                </div>
                                <span class="material-symbols-outlined text-secondary">credit_card</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">$32.500 CLP</div>
                                    <div class="text-label-sm text-on-surface-variant">Transferencia</div>
                                </div>
                                <span class="material-symbols-outlined text-secondary">account_balance</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">$89.990 CLP</div>
                                    <div class="text-label-sm text-on-surface-variant">Débito</div>
                                </div>
                                <span class="material-symbols-outlined text-secondary">credit_score</span>
                            </div>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all">
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-4 border-b border-surface-container-highest pb-2">Pedidos cancelados</h3>
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10238</div>
                                    <div class="text-label-sm text-on-surface-variant">Pago rechazado</div>
                                </div>
                                <span class="material-symbols-outlined text-error">cancel</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10221</div>
                                    <div class="text-label-sm text-on-surface-variant">A petición del cliente</div>
                                </div>
                                <span class="material-symbols-outlined text-error">cancel</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="font-label-md text-on-surface">#10210</div>
                                    <div class="text-label-sm text-on-surface-variant">Falta de stock</div>
                                </div>
                                <span class="material-symbols-outlined text-error">cancel</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráficos -->
            <div class="flex flex-col">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-surface-container-highest pb-3">
                    <h2 class="font-headline-md text-[28px] text-on-surface mb-0 pb-0 border-b-0">Gráficos</h2>
                    <div class="flex flex-wrap items-center gap-2">
                        <button class="px-4 py-2 rounded-full border border-secondary text-secondary font-label-md text-label-sm bg-secondary/10">Hoy</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors">Últimos 7 días</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors">Último mes</button>
                        <button class="px-4 py-2 rounded-full border border-surface-container-highest text-on-surface-variant font-label-md text-label-sm hover:border-secondary/50 hover:text-on-surface transition-colors flex items-center gap-2">Rango personalizado <span class="material-symbols-outlined text-[16px]">calendar_today</span></button>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all min-h-[400px]">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="font-headline-md text-headline-md text-on-surface">Ventas</h2>
                        </div>
                        <div class="flex-1 w-full flex flex-col gap-6 justify-center pt-4">
                            <div class="flex items-end justify-around w-full gap-4 mb-8 h-full">
                                <div class="flex flex-col items-center justify-end gap-3 h-full flex-1">
                                    <span class="text-label-md text-secondary font-bold">45%</span>
                                    <div class="w-full bg-secondary rounded-t-lg shadow-[0_0_15px_rgba(233,195,73,0.3)] transition-all duration-500" style="height: 45%"></div>
                                    <span class="text-[10px] text-on-surface-variant uppercase tracking-widest text-center">Perfumes</span>
                                </div>
                                <div class="flex flex-col items-center justify-end gap-3 h-full flex-1">
                                    <span class="text-label-md text-primary-container font-bold">35%</span>
                                    <div class="w-full bg-primary-container rounded-t-lg shadow-[0_0_15px_rgba(75,0,130,0.3)] transition-all duration-500" style="height: 35%"></div>
                                    <span class="text-[10px] text-on-surface-variant uppercase tracking-widest text-center">Joyería</span>
                                </div>
                                <div class="flex flex-col items-center justify-end gap-3 h-full flex-1">
                                    <span class="text-label-md text-tertiary font-bold">20%</span>
                                    <div class="w-full bg-tertiary rounded-t-lg shadow-[0_0_15px_rgba(200,198,197,0.3)] transition-all duration-500" style="height: 20%"></div>
                                    <span class="text-[10px] text-on-surface-variant uppercase tracking-widest text-center">Lencería</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-xl flex flex-col glow-hover transition-all min-h-[400px]">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="font-headline-md text-headline-md text-on-surface">Productos más vendidos</h2>
                        </div>
                        <div class="flex-1 w-full flex flex-col gap-4 justify-center pt-4">
                            <div class="flex flex-col gap-1 w-full">
                                <div class="flex justify-between text-label-sm text-on-surface-variant">
                                    <span>Élixir de Nuit</span><span>$4.200</span>
                                </div>
                                <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                                    <div class="bg-secondary h-full rounded-full" style="width: 85%"></div>
                                </div>
                            </div>
                            <div class="flex flex-col gap-1 w-full mt-2">
                                <div class="flex justify-between text-label-sm text-on-surface-variant">
                                    <span>Colgante Áureo</span><span>$8.075</span>
                                </div>
                                <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                                    <div class="bg-secondary/80 h-full rounded-full" style="width: 65%"></div>
                                </div>
                            </div>
                            <div class="flex flex-col gap-1 w-full mt-2">
                                <div class="flex justify-between text-label-sm text-on-surface-variant">
                                    <span>Bolso Sentido</span><span>$14.700</span>
                                </div>
                                <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                                    <div class="bg-secondary/60 h-full rounded-full" style="width: 45%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="/javascripts/admin/sidebar-toggle.js"></script>
</body>
</html>
