<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Cupones y promociones' }) %>
</head>
<body class="bg-background text-on-surface font-body-md antialiased overflow-x-hidden selection:bg-secondary selection:text-on-secondary">

<%- include('../partials/admin/mobile-topbar') %>
<%- include('../partials/admin/sidebar', { activo: 'cupones', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<% const TIPO_LABELS = { porcentaje: 'Porcentaje', monto_fijo: 'Monto Fijo', envio_gratis: 'Envío Gratis' }; %>
<% const ESTADO_LABELS = { activo: 'Activo', inactivo: 'Inactivo', expirado: 'Expirado', agotado: 'Agotado' }; %>
<% const ESTADO_BADGE = {
    activo: 'bg-emerald-950/80 border-emerald-500/40 text-emerald-300',
    inactivo: 'bg-surface-container-highest border-outline-variant/40 text-on-surface-variant',
    expirado: 'bg-error-container/40 border-error/30 text-error',
    agotado: 'bg-secondary/10 border-secondary/30 text-secondary'
}; %>

<div class="flex h-screen overflow-hidden">
    <main class="flex-1 flex flex-col h-full overflow-y-auto md:ml-64 bg-background custom-scrollbar">
        <header class="hidden md:flex items-center justify-between px-8 lg:px-12 py-5 sticky top-0 z-30 bg-background/90 backdrop-blur-md border-b border-surface-container-highest">
            <div class="flex flex-col">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-secondary text-2xl">local_offer</span>
                    <h1 class="font-headline-md text-[26px] text-on-surface font-semibold tracking-wide">Gestión de Cupones &amp; Promociones</h1>
                </div>
                <p class="text-xs text-on-surface-variant mt-0.5">Crea, administra y supervisa los códigos de descuento e incentivos de la boutique</p>
            </div>
            <button class="flex items-center gap-2 bg-secondary hover:bg-secondary-fixed text-on-secondary px-4 py-2 rounded-lg font-label-md text-xs uppercase tracking-wider font-semibold shadow-[0_0_15px_rgba(233,195,73,0.25)] transition-all cursor-pointer" onclick="openCreateCouponModal()">
                <span class="material-symbols-outlined text-[18px]">add_circle</span> Crear Cupón
            </button>
        </header>

        <div class="p-6 md:p-8 lg:p-10 max-w-container-max mx-auto w-full flex flex-col gap-6">
            <!-- Metrics -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <div class="glass-panel p-5 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-secondary">
                    <div>
                        <span class="font-label-sm text-[11px] text-on-surface-variant uppercase tracking-wider block mb-1">Cupones Activos</span>
                        <div class="font-headline-lg text-[32px] font-bold text-secondary flex items-baseline gap-2">
                            <%= metricas.activos %> <span class="text-xs text-on-surface-variant font-normal font-label-sm">/ <%= metricas.total %> totales</span>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary">
                        <span class="material-symbols-outlined text-[26px]">confirmation_number</span>
                    </div>
                </div>
                <div class="glass-panel p-5 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-primary">
                    <div>
                        <span class="font-label-sm text-[11px] text-on-surface-variant uppercase tracking-wider block mb-1">Usos este Mes</span>
                        <div class="font-headline-lg text-[32px] font-bold text-on-surface"><%= metricas.usos_mes %></div>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-primary-container/30 border border-primary/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[26px]">redeem</span>
                    </div>
                </div>
                <div class="glass-panel p-5 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-secondary">
                    <div>
                        <span class="font-label-sm text-[11px] text-on-surface-variant uppercase tracking-wider block mb-1">Total Descuentos</span>
                        <div class="font-headline-lg text-[30px] font-bold text-on-surface"><%= formatearCLP(metricas.total_descuentos) %></div>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary">
                        <span class="material-symbols-outlined text-[26px]">savings</span>
                    </div>
                </div>
                <div class="glass-panel p-5 rounded-xl flex items-center justify-between glow-hover transition-all border-l-2 border-l-primary">
                    <div>
                        <span class="font-label-sm text-[11px] text-on-surface-variant uppercase tracking-wider block mb-1">Cupones Totales</span>
                        <div class="font-headline-lg text-[32px] font-bold text-secondary"><%= metricas.total %></div>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-primary-container/30 border border-primary/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[26px]">loyalty</span>
                    </div>
                </div>
            </div>

            <!-- Filtros -->
            <form method="GET" action="/admin/cupones" class="glass-panel p-4 rounded-xl flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 border border-outline-variant/30">
                <div class="flex items-center gap-3 flex-1">
                    <input type="text" name="busqueda" value="<%= filtros.busqueda %>" placeholder="Buscar cupón o código..."
                           class="flex-1 bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-xs text-on-surface placeholder:text-on-surface-variant/60 focus:border-secondary focus:outline-none">
                    <select name="estado" class="bg-surface-container-lowest border border-outline-variant/40 rounded-lg text-xs text-on-surface py-2 px-3 focus:border-secondary focus:outline-none">
                        <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
                        <% Object.entries(ESTADO_LABELS).forEach(([valor, label]) => { %>
                            <option value="<%= valor %>" <%= filtros.estado === valor ? 'selected' : '' %>><%= label %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/admin/cupones" class="px-3 py-2 rounded-lg text-on-surface-variant hover:text-on-surface text-xs">Limpiar</a>
                    <button type="submit" class="bg-secondary text-on-secondary px-4 py-2 rounded-lg text-xs font-semibold">Filtrar</button>
                </div>
            </form>

            <!-- Tabla -->
            <div class="glass-panel rounded-xl border border-surface-container-highest overflow-hidden shadow-2xl">
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                        <tr class="border-b border-surface-container-highest bg-surface-container-lowest/70 text-on-surface-variant font-label-sm text-[11px] uppercase tracking-wider">
                            <th class="py-3.5 px-4 font-semibold">Código</th>
                            <th class="py-3.5 px-4 font-semibold">Descripción</th>
                            <th class="py-3.5 px-4 font-semibold">Tipo</th>
                            <th class="py-3.5 px-4 font-semibold">Valor</th>
                            <th class="py-3.5 px-4 font-semibold">Vigencia</th>
                            <th class="py-3.5 px-4 font-semibold">Usos</th>
                            <th class="py-3.5 px-4 font-semibold text-center">Estado</th>
                            <th class="py-3.5 px-4 font-semibold text-right">Acciones</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-container-highest/60 text-xs">
                        <% if (cupones.length === 0) { %>
                            <tr><td colspan="8" class="p-8 text-center text-on-surface-variant">No hay cupones que coincidan con estos filtros.</td></tr>
                        <% } %>
                        <% cupones.forEach(cupon => { %>
                            <tr class="hover:bg-surface-container-high/40 transition-colors group <%= cupon.estadoCalculado !== 'activo' ? 'opacity-75' : '' %>">
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-secondary/10 border border-secondary/30 text-secondary font-mono font-bold tracking-wider">
                                        <%= cupon.codigo %>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-medium text-on-surface text-sm max-w-xs truncate"><%= cupon.descripcion %></div>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap"><%= TIPO_LABELS[cupon.tipo] %></td>
                                <td class="py-4 px-4 whitespace-nowrap font-semibold text-secondary text-sm">
                                    <% if (cupon.tipo === 'porcentaje') { %><%= Number(cupon.valor) %>% DESC.
                                    <% } else if (cupon.tipo === 'monto_fijo') { %><%= formatearCLP(cupon.valor) %>
                                    <% } else { %>100% Envío<% } %>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <div class="text-on-surface font-medium"><%= new Date(cupon.fecha_inicio).toLocaleDateString('es-CL') %></div>
                                    <div class="text-[11px] text-on-surface-variant"><%= cupon.fecha_fin ? 'al ' + new Date(cupon.fecha_fin).toLocaleDateString('es-CL') : 'Sin vencimiento' %></div>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap text-on-surface-variant">
                                    <%= cupon.usos_realizados %><%= cupon.limite_usos ? ' / ' + cupon.limite_usos : '' %>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold border <%= ESTADO_BADGE[cupon.estadoCalculado] %>">
                                        <%= ESTADO_LABELS[cupon.estadoCalculado] %>
                                    </span>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <form method="POST" action="/admin/cupones/<%= cupon.id %>/activar" class="contents">
                                            <button class="w-8 h-4 <%= cupon.activo ? 'bg-emerald-500/80' : 'bg-surface-container-highest border border-outline/30' %> rounded-full relative p-0.5 transition-colors" title="<%= cupon.activo ? 'Desactivar' : 'Activar' %>">
                                                <div class="w-3 h-3 <%= cupon.activo ? 'bg-white ml-auto' : 'bg-outline' %> rounded-full shadow"></div>
                                            </button>
                                        </form>
                                        <button class="p-1 text-on-surface-variant hover:text-secondary rounded hover:bg-surface-container transition-colors" onclick="location.href='/admin/cupones/<%= cupon.id %>/editar'" title="Editar configuración">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <form method="POST" action="/admin/cupones/<%= cupon.id %>/eliminar" class="contents" onsubmit="return confirm('¿Eliminar este cupón?');">
                                            <button class="p-1 text-on-surface-variant hover:text-error rounded hover:bg-error-container/20 transition-colors" title="Eliminar cupón">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Modal Crear/Editar Cupón -->
<div class="fixed inset-0 z-50 items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md overflow-y-auto transition-all hidden" id="couponModal">
    <div class="glass-panel w-full max-w-2xl rounded-2xl border border-secondary/30 shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden my-auto flex flex-col max-h-[92vh]">
        <div class="px-6 py-5 border-b border-surface-container-highest flex items-center justify-between bg-surface-container-lowest/90 sticky top-0 z-10">
            <h2 class="font-headline-md text-xl text-on-surface font-semibold" id="couponModalTitle">Nuevo Cupón</h2>
            <button class="text-on-surface-variant hover:text-secondary p-1.5 rounded-lg hover:bg-surface-container-high transition-colors" onclick="closeCouponModal()">
                <span class="material-symbols-outlined text-[22px]">close</span>
            </button>
        </div>
        <form id="couponForm" method="POST" action="" class="p-6 flex flex-col gap-5 overflow-y-auto text-xs">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div id="couponCodeField">
                    <label class="block text-on-surface font-medium mb-1.5">Código del Cupón *</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2.5 font-mono text-secondary font-bold text-sm tracking-wider uppercase focus:border-secondary focus:outline-none" id="couponCodigo" name="codigo" type="text" required placeholder="EJ: VERANO20">
                </div>
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Descripción *</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2.5 text-on-surface focus:border-secondary focus:outline-none" id="couponDescripcion" name="descripcion" type="text" required placeholder="Ej: Especial Black Friday">
                </div>
            </div>
            <div>
                <label class="block text-on-surface font-medium mb-2">Tipo de Descuento *</label>
                <div class="grid grid-cols-3 gap-3">
                    <label class="coupon-tipo-option cursor-pointer border border-outline-variant/40 rounded-xl p-3 flex flex-col items-center justify-center text-center gap-1.5">
                        <input class="sr-only" name="tipo" type="radio" value="porcentaje" checked>
                        <span class="material-symbols-outlined text-xl">percent</span>
                        <span class="font-semibold text-xs">Porcentaje</span>
                    </label>
                    <label class="coupon-tipo-option cursor-pointer border border-outline-variant/40 rounded-xl p-3 flex flex-col items-center justify-center text-center gap-1.5">
                        <input class="sr-only" name="tipo" type="radio" value="monto_fijo">
                        <span class="material-symbols-outlined text-xl">payments</span>
                        <span class="font-semibold text-xs">Monto Fijo</span>
                    </label>
                    <label class="coupon-tipo-option cursor-pointer border border-outline-variant/40 rounded-xl p-3 flex flex-col items-center justify-center text-center gap-1.5">
                        <input class="sr-only" name="tipo" type="radio" value="envio_gratis">
                        <span class="material-symbols-outlined text-xl">local_shipping</span>
                        <span class="font-semibold text-xs">Envío Gratis</span>
                    </label>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div id="couponValorField">
                    <label class="block text-on-surface font-medium mb-1.5">Valor del Descuento *</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponValor" name="valor" type="number" min="0" step="1">
                </div>
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Compra Mínima (CLP)</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponCompraMinima" name="compraMinima" type="number" min="0" step="1" value="0">
                </div>
                <div id="couponTopeField">
                    <label class="block text-on-surface font-medium mb-1.5">Tope Máximo (CLP)</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponTope" name="topeMaximo" type="number" min="0" step="1" placeholder="Sin tope">
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Fecha de Inicio *</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponFechaInicio" name="fechaInicio" type="date" required>
                </div>
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Fecha de Vencimiento</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponFechaFin" name="fechaFin" type="date">
                </div>
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Límite Total de Usos</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponLimiteUsos" name="limiteUsos" type="number" min="1" placeholder="Ilimitado">
                </div>
                <div>
                    <label class="block text-on-surface font-medium mb-1.5">Límite de Usos por Cliente</label>
                    <input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-lg px-3 py-2 text-on-surface focus:border-secondary focus:outline-none" id="couponLimitePorCliente" name="limitePorCliente" type="number" min="1" value="1">
                </div>
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="activo" id="couponActivo" class="checkbox-premium" checked>
                <span class="font-body-md text-body-md text-on-surface">Activo inmediatamente</span>
            </label>
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-surface-container-highest">
                <button class="px-5 py-2 rounded-lg border border-outline-variant/40 text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors font-medium text-xs uppercase tracking-wider" onclick="closeCouponModal()" type="button">Cancelar</button>
                <button class="flex items-center gap-2 px-6 py-2 rounded-lg bg-secondary hover:bg-secondary-fixed text-on-secondary font-semibold text-xs uppercase tracking-wider transition-all" type="submit">
                    <span class="material-symbols-outlined text-[18px]">save</span> Guardar Cupón
                </button>
            </div>
        </form>
    </div>
</div>

<% if (cuponEditando) { %>
    <script>
        window.__editarCupon = {
            id: <%- JSON.stringify(cuponEditando.id) %>,
            codigo: <%- JSON.stringify(cuponEditando.codigo) %>,
            descripcion: <%- JSON.stringify(cuponEditando.descripcion) %>,
            tipo: <%- JSON.stringify(cuponEditando.tipo) %>,
            valor: <%- JSON.stringify(cuponEditando.valor) %>,
            compraMinima: <%- JSON.stringify(cuponEditando.compra_minima) %>,
            topeMaximo: <%- JSON.stringify(cuponEditando.tope_maximo) %>,
            fechaInicio: <%- JSON.stringify(cuponEditando.fecha_inicio ? cuponEditando.fecha_inicio.toISOString().slice(0,10) : '') %>,
            fechaFin: <%- JSON.stringify(cuponEditando.fecha_fin ? cuponEditando.fecha_fin.toISOString().slice(0,10) : '') %>,
            limiteUsos: <%- JSON.stringify(cuponEditando.limite_usos) %>,
            limitePorCliente: <%- JSON.stringify(cuponEditando.limite_por_cliente) %>,
            activo: <%- JSON.stringify(cuponEditando.activo) %>
        };
    </script>
<% } %>

<style>
    .coupon-tipo-option:has(input:checked) {
        border-color: var(--secondary, #e9c349);
        background: rgba(233, 195, 73, 0.12);
        color: #e9c349;
    }
</style>

<script src="/javascripts/admin/sidebar-toggle.js"></script>
<script src="/javascripts/admin/cupones.js"></script>
</body>
</html>