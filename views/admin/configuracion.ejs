                 id="save-toast">
                <span class="material-symbols-outlined text-secondary">check_circle</span>
                <div>
                    <div class="font-label-md text-on-surface font-bold">Configuración guardada</div>
                    <div class="text-label-sm text-on-surface-variant">Los parámetros han sido sincronizados en
                        producción.
                    </div>
                </div>
