<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <%- include('../partials/admin/head', { titulo: 'Clientes' }) %>
</head>
<body class="bg-surface font-body-md text-on-surface selection:bg-secondary selection:text-on-secondary">

<%- include('../partials/admin/mobile-topbar') %>
<%- include('../partials/admin/sidebar', { activo: 'clientes', pedidosPendientes: typeof pedidosPendientes !== 'undefined' ? pedidosPendientes : 0 }) %>

<% const ESTADO_LABELS = { activo: 'Activo', bloqueado: 'Bloqueado', inactivo: 'Inactivo' }; %>
<% const ESTADO_BADGE = {
    activo: 'bg-emerald-950/70 text-emerald-300 border-emerald-500/20',
    bloqueado: 'bg-error-container/80 text-on-error-container border-error/30',
    inactivo: 'bg-surface-container-highest text-outline border-outline/30'
}; %>
<% const PEDIDO_ESTADO_LABELS = { procesando: 'Procesando', enviado: 'Enviado', entregado: 'Entregado', devuelto: 'Devuelto', cancelado: 'Cancelado' }; %>

<div class="pl-72">
    <main class="w-full bg-surface min-h-screen">
        <div class="flex flex-col w-full">
            <div class="relative w-full overflow-hidden px-8 py-8 lg:px-12">
                <!-- Encabezado -->
                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8">
                    <div class="flex flex-col gap-2 max-w-2xl">
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                            <span class="font-label-sm text-label-sm uppercase tracking-widest text-outline">Módulo de Clientes</span>
                        </div>
                        <h1 class="font-headline-lg text-headline-lg tracking-tight text-on-surface">Gestión de Clientes</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant">Control integral de la base de clientes, historial de compras y estado de cuenta.</p>
                    </div>
                </div>

                <!-- Filtros -->
                <form method="GET" action="/admin/clientes" class="bg-surface-container-low rounded-xl p-6 mb-8 shadow-xl relative backdrop-blur-md">
                    <div class="flex items-center justify-between pb-4 mb-5 border-b border-surface-container-high/40">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary text-[20px]">filter_alt</span>
                            <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface">Filtros</span>
                        </div>
                        <span class="font-label-sm text-label-sm text-outline"><%= total %> Cliente<%= total !== 1 ? 's' : '' %> Registrado<%= total !== 1 ? 's' : '' %></span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Nombre o Correo</label>
                            <div class="relative flex items-center">
                                <span class="material-symbols-outlined absolute left-3 text-outline text-[18px]">search</span>
                                <input name="busqueda" value="<%= filtros.busqueda %>" class="w-full bg-surface-container-high text-on-surface placeholder:text-outline/70 pl-9 pr-3 py-2.5 rounded-lg text-body-md font-body-md focus:outline-none focus:bg-surface-container-highest transition-colors"
                                       placeholder="Buscar cliente..." type="text">
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Estado de Cuenta</label>
                            <select name="estado" class="w-full bg-surface-container-high text-on-surface pl-3 pr-3 py-2.5 rounded-lg text-body-md font-body-md focus:outline-none focus:bg-surface-container-highest transition-colors cursor-pointer">
                                <option value="" <%= filtros.estado === '' ? 'selected' : '' %>>Todos los estados</option>
                                <% Object.entries(ESTADO_LABELS).forEach(([valor, label]) => { %>
                                    <option value="<%= valor %>" <%= filtros.estado === valor ? 'selected' : '' %>><%= label %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Fecha Registro</label>
                            <select name="fecha" class="w-full bg-surface-container-high text-on-surface pl-3 pr-3 py-2.5 rounded-lg text-body-md font-body-md focus:outline-none focus:bg-surface-container-highest transition-colors cursor-pointer">
                                <option value="" <%= filtros.fecha === '' ? 'selected' : '' %>>Cualquier fecha</option>
                                <option value="30dias" <%= filtros.fecha === '30dias' ? 'selected' : '' %>>Últimos 30 días</option>
                                <option value="anio" <%= filtros.fecha === 'anio' ? 'selected' : '' %>>Este año</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Volumen de Pedidos</label>
                            <select name="pedidos" class="w-full bg-surface-container-high text-on-surface pl-3 pr-3 py-2.5 rounded-lg text-body-md font-body-md focus:outline-none focus:bg-surface-container-highest transition-colors cursor-pointer">
                                <option value="" <%= filtros.pedidos === '' ? 'selected' : '' %>>Todos los clientes</option>
                                <option value="con-pedidos" <%= filtros.pedidos === 'con-pedidos' ? 'selected' : '' %>>Clientes con pedidos</option>
                                <option value="sin-pedidos" <%= filtros.pedidos === 'sin-pedidos' ? 'selected' : '' %>>Clientes sin pedidos</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-3 mt-5 pt-4">
                        <a href="/admin/clientes" class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-outline hover:text-on-surface hover:bg-surface-container-high transition-colors font-label-md text-label-md uppercase tracking-wider">
                            <span class="material-symbols-outlined text-[17px]">restart_alt</span> Limpiar
                        </a>
                        <button type="submit" class="flex items-center gap-2 px-6 py-2.5 rounded-lg bg-secondary hover:bg-secondary-fixed text-on-secondary font-label-md text-label-md uppercase tracking-widest transition-all">
                            <span class="material-symbols-outlined text-[18px]">search_check</span> Filtrar
                        </button>
                    </div>
                </form>

                <!-- Tabla -->
                <div class="w-full bg-surface-container-lowest rounded-xl border border-[#262626] overflow-hidden shadow-2xl">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                            <tr class="bg-surface-container-low text-outline font-label-sm text-label-sm uppercase tracking-wider select-none">
                                <th class="py-4 px-6">Cliente</th>
                                <th class="py-4 px-6 text-center">Estado</th>
                                <th class="py-4 px-6 text-right">Pedidos</th>
                                <th class="py-4 px-6 text-right">Total Comprado</th>
                                <th class="py-4 px-6 text-center">Acciones</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y-0 text-on-surface font-body-md text-body-md">
                            <% if (clientes.length === 0) { %>
                                <tr><td colspan="5" class="p-8 text-center text-on-surface-variant">No hay clientes que coincidan con estos filtros.</td></tr>
                            <% } %>
                            <% clientes.forEach(cliente => { %>
                                <% const iniciales = (cliente.nombre[0] || '') + (cliente.apellido[0] || ''); %>
                                <tr class="hover:bg-surface-container-high/40 transition-colors group">
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-primary-container text-secondary flex items-center justify-center font-headline-md text-label-md font-bold shadow-sm shrink-0">
                                                <%= iniciales.toUpperCase() %>
                                            </div>
                                            <div class="flex flex-col min-w-0 gap-1">
                                                <span class="font-semibold text-on-surface group-hover:text-secondary transition-colors truncate"><%= cliente.nombre %> <%= cliente.apellido %></span>
                                                <span class="text-label-sm text-on-surface-variant truncate"><%= cliente.email %></span>
                                                <% if (cliente.telefono) { %>
                                                    <span class="text-label-sm text-outline flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">call</span><%= cliente.telefono %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-label-sm font-label-sm tracking-wide <%= ESTADO_BADGE[cliente.estadoCalculado] %>">
                                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span> <%= ESTADO_LABELS[cliente.estadoCalculado] %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-right font-label-md text-label-md text-on-surface"><%= cliente.total_pedidos %> pedido<%= Number(cliente.total_pedidos) !== 1 ? 's' : '' %></td>
                                    <td class="py-4 px-6 text-right font-semibold <%= Number(cliente.total_gastado) > 0 ? 'text-secondary' : 'text-outline' %>"><%= formatearCLP(cliente.total_gastado) %></td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center justify-center gap-1">
                                            <button class="p-2 rounded hover:bg-surface-container-highest text-secondary hover:text-secondary-fixed transition-colors"
                                                    data-abrir-detalle-cliente="<%= cliente.id %>" title="Ver perfil">
                                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                                            </button>
                                            <form method="POST" action="/admin/clientes/<%= cliente.id %>/bloquear" class="contents" onsubmit="return confirm('<%= cliente.bloqueado ? '¿Desbloquear a este cliente?' : '¿Bloquear a este cliente? No podrá iniciar sesión.' %>');">
                                                <button class="p-2 rounded hover:bg-surface-container-highest <%= cliente.bloqueado ? 'text-error hover:text-on-error-container' : 'text-on-surface-variant hover:text-error' %> transition-colors"
                                                        title="<%= cliente.bloqueado ? 'Desbloquear' : 'Bloquear' %>">
                                                    <span class="material-symbols-outlined text-[20px]"><%= cliente.bloqueado ? 'lock_open' : 'lock' %></span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Paginación -->
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 bg-surface-container-low/50 gap-4 border-t border-[#262626]">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Página <%= paginaActual %> de <%= totalPaginas %> — <%= total %> resultados</span>
                        <div class="flex items-center gap-2">
                            <% const qs = (p) => { const params = new URLSearchParams({ ...filtros, pagina: p }); Object.keys(filtros).forEach(k => { if (!filtros[k]) params.delete(k); }); return params.toString(); }; %>
                            <a href="/admin/clientes?<%= qs(Math.max(1, paginaActual - 1)) %>"
                               class="px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant text-label-sm font-label-sm <%= paginaActual <= 1 ? 'opacity-30 pointer-events-none' : '' %>">
                                Anterior
                            </a>
                            <a href="/admin/clientes?<%= qs(Math.min(totalPaginas, paginaActual + 1)) %>"
                               class="px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface text-label-sm font-label-sm <%= paginaActual >= totalPaginas ? 'opacity-30 pointer-events-none' : '' %>">
                                Siguiente
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Drawer de detalle (se llena vía AJAX al abrir) -->
            <aside class="fixed right-0 top-0 h-full w-full sm:w-[640px] max-w-2xl bg-surface-container-lowest border-l border-secondary/20 shadow-[-12px_0_40px_rgba(0,0,0,0.85)] z-50 flex flex-col justify-between transition-transform duration-300 ease-in-out overflow-hidden translate-x-full"
                   id="client-drawer">
                <div class="px-6 sm:px-8 py-5 border-b border-[#262626] bg-[#0e0e0e]/95 backdrop-blur-md flex items-center justify-between sticky top-0 z-10">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-full bg-primary-container/80 border border-secondary/40 text-secondary flex items-center justify-center font-headline-md text-base font-bold shadow-inner">
                            <span id="drawer-avatar">--</span>
                        </div>
                        <div class="flex flex-col">
                            <div class="flex items-center gap-2">
                                <h2 class="font-headline-md text-xl sm:text-2xl text-on-surface font-semibold tracking-tight" id="drawer-client-name">Cargando...</h2>
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium border" id="drawer-status-badge"></span>
                            </div>
                            <span class="font-label-sm text-[12px] text-outline tracking-wider uppercase">Ficha de Cliente • ID: <span id="drawer-client-id"></span></span>
                        </div>
                    </div>
                    <button class="p-2 rounded-lg text-outline hover:text-on-surface hover:bg-surface-container-high transition-colors" onclick="closeClientDrawer()" title="Cerrar panel">
                        <span class="material-symbols-outlined text-[22px]">close</span>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto px-6 sm:px-8 py-6 space-y-7 text-on-surface" id="drawer-content">
                    <div class="flex items-center justify-center py-12 text-on-surface-variant">
                        <span class="material-symbols-outlined animate-spin">progress_activity</span>
                    </div>
                </div>

                <div class="px-6 sm:px-8 py-4 border-t border-[#262626] bg-[#0e0e0e]/95 backdrop-blur-md flex items-center justify-between gap-3 sticky bottom-0">
                    <button class="px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-md text-xs uppercase tracking-wider transition-colors" onclick="closeClientDrawer()">
                        Cerrar
                    </button>
                    <div class="flex items-center gap-2" id="drawer-acciones"></div>
                </div>
            </aside>
            <div class="fixed inset-0 bg-background/70 backdrop-blur-sm z-40 transition-opacity duration-300 hidden" id="drawer-backdrop" onclick="closeClientDrawer()"></div>
        </div>
    </main>
</div>

<script>
    window.__PEDIDO_ESTADO_LABELS = <%- JSON.stringify(PEDIDO_ESTADO_LABELS) %>;
    window.__ESTADO_LABELS = <%- JSON.stringify(ESTADO_LABELS) %>;
</script>
<script src="/javascripts/admin/sidebar-toggle.js"></script>
<script src="/javascripts/admin/clientes.js"></script>
</body>
</html>