                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                        <!-- Búsqueda Nombre o ID -->
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Nombre</label>
