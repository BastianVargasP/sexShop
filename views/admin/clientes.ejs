                    <div class="flex flex-col gap-2 max-w-2xl">
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                            <span class="font-label-sm text-label-sm uppercase tracking-widest text-outline">Módulo de Clientes de Élite</span>
                        </div>
                        <h1 class="font-headline-lg text-headline-lg tracking-tight text-on-surface">Gestión de
                            Clientes</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant">Control integral de la base de
                            clientes exclusivos, historial de compras y actividad de boutique.</p>
                    </div>
