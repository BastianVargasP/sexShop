<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-surface text-on-surface min-h-screen flex relative flex-col">

<%- include('partials/header') %>

<!-- Decorative background elements -->
<div class="absolute inset-0 z-0 pointer-events-none opacity-20"
     data-alt="A highly abstract, dark and moody background image featuring subtle, soft-focus swirling smoke or velvet textures in deep charcoal and muted violet tones. The lighting is extremely low and sophisticated, hinting at luxury and mystery, suitable for a premium boutique dark mode interface. There are no distinct objects, just elegant atmospheric gradients."
     style="background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuB5-PzEmKxwQXNWKNStXzTUlxmUqcAv1eFjatVV9UINXHPPP4OnvMSaWFroN3aQLLncEAtnPPFUglnIX7UlB2ZZZPBx3FFPB6Y5GYPalKna9lHpvnpPGzhmvDLfOS8K3VQONqW_XhDLUPzaPS3ePHdSrxLIWskFb39hOt3l3pFQlq8yhV8-jLu4zp0WL38-rylATbwtFHWRRar2oVjkKWhMCoLBRhFhKkFLo39bpa6HzalvhFlT_NI&quot;); background-size: cover; background-repeat: no-repeat; background-position: center center;">
</div>
<div class="relative z-10 w-full max-w-md px-margin-mobile md:px-0 flex-grow flex flex-col justify-center mx-auto py-12">
    <!-- Login Card -->
    <div class="glass-panel rounded-xl p-8 shadow-2xl relative">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-8 text-center">Bienvenido de nuevo</h2>
        <form action="#" class="space-y-6" method="POST">
            <!-- Email Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                           for="email" style="text-shadow: 0px 0px 1px rgba(0,0,0,0.5);">Email</label>
                    <input class="flex-1 bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                           id="email" name="email" placeholder="correo@ejemplo.com" required="" type="email">
                </div>
            </div>
            <!-- Password Input -->
            <div class="relative group">
                <div class="flex items-center gap-4 border-b border-surface-variant pb-2">
                    <label class="w-1/3 text-on-surface-variant font-label-md text-label-md uppercase tracking-wider"
                           for="password" style="text-shadow: 0px 0px 1px rgba(0,0,0,0.5);">Clave</label>
                    <div class="flex-1 flex items-center">
                        <input class="w-full bg-transparent border-0 focus:ring-0 text-on-surface font-body-md text-body-md p-0 placeholder-on-surface-variant/30"
                               id="password" name="password" placeholder="••••••••" required="" type="password">
                        <button aria-label="Toggle password visibility" id="btnVerContrasena"
                                class="text-on-surface-variant hover:text-secondary transition-colors" type="button">
                            <span id="iconoVisibilidad" class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">visibility_off</span>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Additional Options -->
            <div class="flex items-center justify-between pt-2">
                <div class="flex items-center">
                    <input class="h-4 w-4 rounded border-surface-variant bg-[#1A1A1A] text-secondary focus:ring-secondary focus:ring-offset-surface"
                           id="remember-me" name="remember-me" type="checkbox">
                    <label class="ml-2 block font-body-md text-body-md text-on-surface-variant" for="remember-me">
                        Recordarme
                    </label>
                </div>
                <a class="font-label-md text-label-md text-secondary hover:text-secondary-fixed transition-colors"
                   href="#">
                    ¿Olvidó su contraseña?
                </a>
            </div>
            <!-- Submit Button -->
            <div class="pt-4">
                <button class="w-full group relative inline-flex items-center justify-center px-10 py-4 overflow-hidden rounded-full font-label-md text-label-md uppercase tracking-wider text-[#0A0A0A] bg-secondary hover:bg-secondary-fixed transition-colors duration-300 shadow-[0_0_20px_rgba(212,175,55,0.15)] hover:shadow-[0_0_30px_rgba(212,175,55,0.3)]"
                        type="submit">Iniciar Sesión
                </button>
            </div>
        </form>
        <!-- Sign Up Link -->
        <div class="mt-8 text-center">
            <p class="font-body-md text-body-md text-on-surface-variant">
                ¿No tiene una cuenta?
                <a class="font-label-md text-label-md text-secondary hover:text-secondary-fixed ml-1 transition-colors border-b border-transparent hover:border-secondary pb-1"
                   href="/auth/registro">
                    Registrarse
                </a>
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
<script src="/javascripts/login.js" defer></script>
</body>
</html>