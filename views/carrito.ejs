<!DOCTYPE html>
<html class="dark" lang="es" style="">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-surface text-on-surface min-h-screen flex relative flex-col">
<!-- TopNavBar -->
<%- include('partials/header') %>
<!-- Main Content -->
<main class="flex-grow pt-8 pb-8 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
    <!-- Header -->
    <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-surface-container-highest pb-6">
        <div>
            <h1 class="font-headline-xl text-headline-xl text-on-surface mb-2">Tu Selección</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant">2 artículos en tu carrito</p>
        </div>
        <a class="font-label-md text-label-md text-secondary hover:text-primary transition-colors flex items-center gap-2 group"
           href="/productos">
            <span class="material-symbols-outlined group-hover:-translate-x-1 transition-transform"
                  data-icon="arrow_back">arrow_back</span>
            Seguir comprando
        </a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Cart Items List -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            <!-- Product 1 -->
            <div class="glass-panel rounded-lg p-4 md:p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center glow-hover transition-all duration-300 relative group">
                <!-- Thumbnail -->
                <div class="w-full sm:w-32 h-32 bg-surface-container-lowest rounded-md overflow-hidden relative shrink-0">
                    <img class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                         data-alt="A dark, moody product photograph of an elegant, minimalist perfume bottle with gold accents. The bottle is presented against a deep black background with soft, dramatic spotlighting highlighting its glass texture and metallic details. Luxury aesthetic, high-end cosmetic styling."
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuAK_yl9bUMD1_1PT4twzOREJiq9REPdV3y7ztKg9br5zPkekuwkfmN5Cx-F3panRNQsMajg4Reje92ImM1V79Y6o7ntigHu6QnxW-7YlgM0eBNAhCzgP6Mj5_-jHVbJ1S9h9cSVKSsqju42Q6rru_CqTEeUTC4SMkhU7UNJk8-nQBt7oM-XK9tIMx9PVudn-xZfmG9hpUako2M_Vh57Bo81c2dZ9sIVFycYkCAnGZW2dPz6WlHU2JU">
                </div>
                <!-- Details -->
                <div class="flex-grow flex flex-col gap-2 w-full">
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <h3 class="font-headline-md text-headline-md text-on-surface text-2xl">Essence de Nuit</h3>
                            <p class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mt-1">Eau de
                                Parfum - 50ml</p>
                        </div>
                        <button aria-label="Remove item"
                                class="text-on-surface-variant hover:text-error transition-colors p-1">
                            <span class="material-symbols-outlined" data-icon="close">close</span>
                        </button>
                    </div>
                    <div class="flex flex-wrap justify-between items-end gap-4 mt-4">
                        <!-- Quantity Adjuster -->
                        <div class="flex items-center border border-secondary/30 rounded bg-surface-container-lowest">
                            <button aria-label="Decrease quantity"
                                    class="px-3 py-1 text-on-surface-variant hover:text-secondary transition-colors">
                                <span class="material-symbols-outlined text-sm" data-icon="remove">remove</span>
                            </button>
                            <span class="font-body-md text-body-md text-on-surface w-8 text-center">1</span>
                            <button aria-label="Increase quantity"
                                    class="px-3 py-1 text-on-surface-variant hover:text-secondary transition-colors">
                                <span class="material-symbols-outlined text-sm" data-icon="add">add</span>
                            </button>
                        </div>
                        <!-- Price -->
                        <div class="text-right">
                            <p class="font-headline-md text-headline-md text-secondary text-xl">€145.00</p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Product 2 -->
            <div class="glass-panel rounded-lg p-4 md:p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center glow-hover transition-all duration-300 relative group">
                <!-- Thumbnail -->
                <div class="w-full sm:w-32 h-32 bg-surface-container-lowest rounded-md overflow-hidden relative shrink-0">
                    <img class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                         data-alt="A sophisticated, dark-themed image of a luxury massage oil bottle with subtle gold text on a matte black label. The product is placed on a reflective dark surface with a faint golden outer glow illuminating its silhouette. Premium intimate wellness concept, mysterious and elegant vibe."
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBGp7KQ8YsurrRIGsy6BGE7NPdI5mnTernVlzLTWUTAqVPj7duGbaKPUPukupWafI1ZNT9aCQTBPBhygKo-_UGzJJ4XmYJyQ6ZETcflQDAQCujr4Zx52NDxYdhIhGOBPiqJWCj9U38AT4qL6Q4lrCuc1jtruJjUNTiInpJeGVtRchVjV2FaYPYYT0JkqFeOopLrlw_Pk7LclJ42tUX6TEjGZr7li2Cou9jUwmgx06ZwfzMQithJgw0">
                </div>
                <!-- Details -->
                <div class="flex-grow flex flex-col gap-2 w-full">
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <h3 class="font-headline-md text-headline-md text-on-surface text-2xl">L'Huile
                                Précieuse</h3>
                            <p class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mt-1">Aceite
                                Corporal - 100ml</p>
                        </div>
                        <button aria-label="Remove item"
                                class="text-on-surface-variant hover:text-error transition-colors p-1">
                            <span class="material-symbols-outlined" data-icon="close">close</span>
                        </button>
                    </div>
                    <div class="flex flex-wrap justify-between items-end gap-4 mt-4">
                        <!-- Quantity Adjuster -->
                        <div class="flex items-center border border-secondary/30 rounded bg-surface-container-lowest">
                            <button aria-label="Decrease quantity"
                                    class="px-3 py-1 text-on-surface-variant hover:text-secondary transition-colors">
                                <span class="material-symbols-outlined text-sm" data-icon="remove">remove</span>
                            </button>
                            <span class="font-body-md text-body-md text-on-surface w-8 text-center">1</span>
                            <button aria-label="Increase quantity"
                                    class="px-3 py-1 text-on-surface-variant hover:text-secondary transition-colors">
                                <span class="material-symbols-outlined text-sm" data-icon="add">add</span>
                            </button>
                        </div>
                        <!-- Price -->
                        <div class="text-right">
                            <p class="font-headline-md text-headline-md text-secondary text-xl">€85.00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Order Summary Sidebar -->
        <div class="lg:col-span-4 mt-8 lg:mt-0">
            <div class="glass-panel rounded-lg p-6 md:p-8 top-28 flex flex-col gap-6">
                <h2 class="font-headline-md text-headline-md text-on-surface border-b border-secondary/20 pb-4">Resumen
                    del Pedido</h2>
                <div class="flex flex-col gap-4 font-body-md text-body-md text-on-surface-variant">
                    <div class="flex justify-between items-center">
                        <span class="">Subtotal</span>
                        <span class="text-on-surface">€230.00</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="">Envío Estimado</span>
                        <span class="text-on-surface">Gratis</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="">Impuestos (IVA incl.)</span>
                        <span class="text-on-surface">Calculado en el checkout</span>
                    </div>
                </div>
                <div class="border-t border-secondary/20 pt-4 flex justify-between items-end mt-2">
                    <span class="font-label-md text-label-md text-on-surface uppercase tracking-widest">Total</span>
                    <span class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-secondary">€230.00</span>
                </div>
                <a href="/checkout" class="w-full bg-secondary text-on-secondary-container font-label-md text-label-md py-4 rounded-md uppercase tracking-widest font-bold hover:bg-secondary-fixed transition-colors mt-4 flex justify-center items-center gap-2 group">
                    Finalizar Compra
                    <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform"
                          data-icon="arrow_forward">arrow_forward</span>
                </a>
                <p class="font-label-sm text-label-sm text-on-surface-variant text-center opacity-70 mt-2 flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]" data-icon="lock">lock</span>
                    Pago seguro y encriptado
                </p>
            </div>
        </div>
    </div>
</main>
<!-- Footer -->
<%- include('partials/footer') %>
<div id="snapdom-sandbox" data-snapdom-sandbox="true" aria-hidden="true"
     style="position: absolute; left: -9999px; top: -9999px; width: 0px; height: 0px; overflow: hidden;"></div>
</body>
</html>